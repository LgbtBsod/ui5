{
  "env": {
    "browser": true,
    "es6": true
  },
  "globals": {
    "QUnit": "readonly",
    "sap": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2015
  },
  "rules": {
    "no-duplicate-imports": "error",
    "no-undef": "warn",
    "no-unused-vars": ["warn", { "args": "none" }],
    "eqeqeq": ["warn", "always", { "null": "ignore" }]
  },
  "ignorePatterns": [
    "dist/",
    "test/"
  ]
}
