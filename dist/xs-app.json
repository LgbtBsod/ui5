{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/sap/opu/odata/sap/Z_EHS_PRODUCTION_CONTROL_CKLT_SRV/(.*)",
      "target": "/sap/opu/odata/sap/Z_EHS_PRODUCTION_CONTROL_CKLT_SRV/$1",
      "destination": "SAP_Gateway",
      "csrfProtection": true
    },
    {
      "source": "^(.*)",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
