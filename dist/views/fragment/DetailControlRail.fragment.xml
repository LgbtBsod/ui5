<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox class="detailControlBar" renderType="Bare" width="100%">
        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailHeroStats" type="XML"/>

        <MessageStrip
            id="detailValidationSummaryStrip"
            text="{path:'state>/validationSummary', formatter:'.formatValidationSummaryText'}"
            type="Error"
            showIcon="true"
            class="sapUiTinyMarginTop sapUiTinyMarginBottom chkFeedbackStrip chkFeedbackError workflowMessageSurface"
            visible="{= ${view>/validationShown} &amp;&amp; ${state>/validationSummary/hasErrors} }">
            <link>
                <Link
                    text="{path:'state>/validationSummary', formatter:'.formatValidationSummaryLinkText'}"
                    tooltip="{i18n>requiredFieldHint}"
                    press=".onFocusFirstInvalid"/>
            </link>
        </MessageStrip>

        <VBox class="detailControlToolbar detailControlToolbarStack" renderType="Bare" width="100%">
            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailSectionAnchorRail" type="XML"/>
            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailControlStatusRow" type="XML"/>
            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailControlActionRow" type="XML"/>
        </VBox>

    </VBox>
</core:FragmentDefinition>
