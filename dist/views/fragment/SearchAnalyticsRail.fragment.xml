<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <HBox class="workflowRail searchHeaderKpiRail searchAnalyticsRailShell" renderType="Bare" wrap="Wrap" justifyContent="Start" alignItems="Stretch">
        <customData>
            <core:CustomData key="role" value="region" writeToDom="true"/>
            <core:CustomData key="aria-label" value="{i18n>kpiRailAriaLabel}" writeToDom="true"/>
        </customData>
        <HBox id="searchAnalyticsRail" class="searchAnalyticsRailGrid" renderType="Bare" wrap="Wrap">
            <VBox class="kpiCard searchAnalyticsCard">
                <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
                    <core:Icon src="sap-icon://task" class="kpiLabelIcon" decorative="true"/>
                    <Text text="{i18n>kpiVisible}" class="kpiLabel"/>
                </HBox>
                <VBox visible="{view>/analyticsRailBusy}" class="appSkeletonMetric" renderType="Bare">
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineShort" renderType="Bare"/>
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineMedium" renderType="Bare"/>
                </VBox>
                <Title text="{view>/analyticsRail/total}" level="H4" visible="{= !${view>/analyticsRailBusy} }" class="appSkeletonReveal kpiValue"/>
                <Text text="{= ${i18n>analyticsSource} + ': ' + (${view>/analyticsRail/sourceText} || '-') }" class="searchAnalyticsMeta" visible="{= !${view>/analyticsRailBusy} }"/>
            </VBox>
            <VBox class="kpiCard searchAnalyticsCard">
                <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
                    <core:Icon src="sap-icon://history" class="kpiLabelIcon" decorative="true"/>
                    <Text text="{i18n>kpiMonthTotal}" class="kpiLabel"/>
                </HBox>
                <VBox visible="{view>/analyticsRailBusy}" class="appSkeletonMetric" renderType="Bare">
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineShort" renderType="Bare"/>
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineMedium" renderType="Bare"/>
                </VBox>
                <Title text="{view>/analyticsRail/monthly}" level="H4" visible="{= !${view>/analyticsRailBusy} }" class="appSkeletonReveal kpiValue"/>
                <Text text="{= ${i18n>workflowUpdatedAt} + ': ' + (${view>/analyticsRail/refreshedAtText} || '-') }" class="searchAnalyticsMeta" visible="{= !${view>/analyticsRailBusy} }"/>
            </VBox>
            <VBox class="kpiCard searchAnalyticsCard kpiCardDanger">
                <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
                    <core:Icon src="sap-icon://inspection" class="kpiLabelIcon" decorative="true"/>
                    <Text text="{i18n>kpiFailedChecks}" class="kpiLabel"/>
                </HBox>
                <VBox visible="{view>/analyticsRailBusy}" class="appSkeletonMetric" renderType="Bare">
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineShort" renderType="Bare"/>
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineMedium" renderType="Bare"/>
                </VBox>
                <Title text="{view>/analyticsRail/failedChecks}" level="H4" visible="{= !${view>/analyticsRailBusy} }" class="appSkeletonReveal kpiValue"/>
                <Text text="{= ${i18n>analyticsAvgChecksRate} + ': ' + (${view>/analyticsRail/avgChecksRate} || 0) + '%' }" class="searchAnalyticsMeta" visible="{= !${view>/analyticsRailBusy} }"/>
            </VBox>
            <VBox class="kpiCard searchAnalyticsCard kpiCardWarning">
                <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
                    <core:Icon src="sap-icon://alert" class="kpiLabelIcon" decorative="true"/>
                    <Text text="{i18n>kpiFailedBarriers}" class="kpiLabel"/>
                </HBox>
                <VBox visible="{view>/analyticsRailBusy}" class="appSkeletonMetric" renderType="Bare">
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineShort" renderType="Bare"/>
                    <VBox class="appSkeleton appSkeletonLine appSkeletonLineMedium" renderType="Bare"/>
                </VBox>
                <Title text="{view>/analyticsRail/failedBarriers}" level="H4" visible="{= !${view>/analyticsRailBusy} }" class="appSkeletonReveal kpiValue"/>
                <Text text="{= ${i18n>analyticsAvgBarriersRate} + ': ' + (${view>/analyticsRail/avgBarriersRate} || 0) + '%' }" class="searchAnalyticsMeta" visible="{= !${view>/analyticsRailBusy} }"/>
            </VBox>
        </HBox>
    </HBox>
</core:FragmentDefinition>
