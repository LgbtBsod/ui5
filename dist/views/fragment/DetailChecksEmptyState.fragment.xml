<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox
        class="detailEmptyStateCard workflowEmptyStateCard detailChecksEmptyState"
        renderType="Bare"
        visible="{path:'selected>/checks', formatter:'.isEmptyRows'}">
        <core:Icon src="sap-icon://complete" class="detailEmptyStateIcon workflowEmptyStateIcon"/>
        <Title text="{i18n>detailEmptyChecksTitle}" level="H6" class="detailEmptyStateTitle workflowEmptyStateTitle"/>
        <Text text="{i18n>detailEmptyChecksText}" class="detailEmptyStateText workflowEmptyStateText"/>
        <Button
            text="{i18n>addRow}"
            icon="sap-icon://task"
            type="Transparent"
            press=".onAddCheckRow"
            visible="{= ${state>/workflow/detail/editMode} !== 'READ' }"
            class="detailEmptyStateAction workflowEmptyStateAction"/>
    </VBox>
</core:FragmentDefinition>
