<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox class="detailControlBar" renderType="Bare" width="100%">

        <HBox class="uxStatRow detailHeroStatBoard" wrap="Wrap" renderType="Bare">
            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>checklistLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/root/id} || ${i18n>newChecklist} }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>overallResultLabel}" class="sapUiTinyMarginEnd"/>
                <ObjectStatus
                    text="{path:'selected>/root/overall_result', formatter:'.formatBooleanResultText'}"
                    state="{path:'selected>/root/overall_result', formatter:'.formatBooleanResultState'}"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>objectStatusLabel}" class="sapUiTinyMarginEnd"/>
                <ObjectStatus
                    text="{path:'selected>/root/status', formatter:'.formatLifecycleStatusText'}"
                    state="{path:'selected>/root/status', formatter:'.formatLifecycleStatusState'}"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>headerDateLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{path:'selected>/basic/date', formatter:'.formatHeaderDate'}"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>observerLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/basic/OBSERVER_FULLNAME} || '-' }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>observedLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/basic/OBSERVED_FULLNAME} || '-' }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>equipmentLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/basic/equipment} || '-' }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>locationLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/basic/LOCATION_NAME} || ${selected>/basic/LOCATION_TEXT} || ${selected>/basic/LOCATION_KEY} || '-' }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>headerProfessionLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/basic/PROF_TEXT} || '-' }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>headerLpcLabel}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${selected>/basic/LPC_TEXT} || '-' }"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>editMode}" class="sapUiTinyMarginEnd"/>
                <Text text="{= ${state>/mode} !== 'READ' ? ${i18n>modeEdit} : ${i18n>modeRead} }"/>
            </HBox>
        </HBox>

        <MessageStrip
            id="detailValidationSummaryStrip"
            text="{path:'state>/validationSummary', formatter:'.formatValidationSummaryText'}"
            type="Error"
            showIcon="true"
            class="sapUiTinyMarginTop sapUiTinyMarginBottom rnvFeedbackStrip rnvFeedbackError"
            visible="{= ${view>/validationShown} &amp;&amp; ${state>/validationSummary/hasErrors} }">
            <link>
                <Link
                    text="{path:'state>/validationSummary', formatter:'.formatValidationSummaryLinkText'}"
                    tooltip="{i18n>requiredFieldHint}"
                    press=".onFocusFirstInvalid"/>
            </link>
        </MessageStrip>

        <VBox class="detailControlToolbar detailControlToolbarStack" renderType="Bare" width="100%">
            <HBox class="detailSectionAnchorRail" renderType="Bare" wrap="Wrap" alignItems="Center">
                <Button text="{i18n>detailAnchorChecks}"
                        icon="sap-icon://inspection"
                        type="Transparent"
                        class="detailSectionAnchorBtn rnvRipple"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssChecks"/></customData>
                </Button>
                <Button text="{i18n>detailAnchorBarriers}"
                        icon="sap-icon://warning2"
                        type="Transparent"
                        class="detailSectionAnchorBtn rnvRipple"
                        visible="{path:'selected>/basic/LPC_KEY', formatter:'.isBarriersVisibleByLpc'}"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssBarriers"/></customData>
                </Button>
                <Button text="{i18n>detailAnchorAttachments}"
                        icon="sap-icon://attachment"
                        type="Transparent"
                        class="detailSectionAnchorBtn rnvRipple"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssAttachments"/></customData>
                </Button>
            </HBox>

            <OverflowToolbar class="detailControlRow detailControlRowTop toolbarTransparent" design="Transparent">
                <ObjectStatus
                    icon="sap-icon://status-in-process"
                    text="{path:'selected>/root/status', formatter:'.formatLifecycleStatusText'}"
                    state="{path:'selected>/root/status', formatter:'.formatLifecycleStatusState'}"
                    class="detailRailStatusChip"/>

                <ObjectStatus icon="sap-icon://edit"
                              text="{= ${state>/isDirty} ? ${i18n>dirtyStateDirty} : ${i18n>dirtyStateSynced} }"
                              state="{= ${state>/isDirty} ? 'Warning' : 'Success' }"
                              class="detailRailStatusChip">
                    <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
                </ObjectStatus>

                <ObjectStatus icon="sap-icon://history"
                              text="{parts:[{path:'state>/mode'},{path:'state>/lockOperationState'}], formatter:'.formatHeartbeatText'}"
                              state="{= ${state>/mode} === 'EDIT' &amp;&amp; ${state>/lockOperationState} === 'LOCKED' ? 'Success' : 'Information' }"
                              class="detailRailStatusChip">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </ObjectStatus>

                <ObjectStatus icon="sap-icon://synchronize"
                              text="{parts:[{path:'state>/mode'},{path:'state>/autosaveState'}], formatter:'.formatAutosaveText'}"
                              state="{= ${state>/mode} !== 'EDIT' ? 'Information' : ${state>/autosaveState} === 'ERROR' ? 'Error' : ${state>/autosaveState} === 'SAVING' ? 'Warning' : ${state>/autosaveState} === 'SAVED' ? 'Success' : 'Information' }"
                              class="detailRailStatusChip">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </ObjectStatus>

                <ToolbarSpacer/>

                <BusyIndicator visible="{= ${state>/isBusy} || ${state>/saveInFlight} }" size="1rem" class="sapUiTinyMarginEnd">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </BusyIndicator>

                <Button icon="sap-icon://undo"
                        text="{i18n>objectCancel}"
                        visible="{= ${state>/mode} !== 'READ' &amp;&amp; !!${state>/isDirty} }"
                        enabled="{= !${state>/isBusy} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onCancelEditFromDetail"
                        tooltip="{i18n>objectCancel}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
                </Button>

            </OverflowToolbar>

            <OverflowToolbar class="detailControlRow detailControlRowActions toolbarTransparent" design="Transparent">
                <Button icon="sap-icon://nav-back"
                        text="{i18n>closeButton}"
                        type="Transparent"
                        enabled="{= !${state>/isBusy} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onCloseDetail"
                        tooltip="{i18n>closeDetails}"
                        class="detailRailCloseAction rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                </Button>

                <core:Fragment fragmentName="sap_ui5.view.fragment.LockSwitchStatus" type="XML"/>

                <Button icon="sap-icon://save" type="Emphasized"
                        text="{i18n>objectSave}"
                        visible="{= ${state>/mode} !== 'READ' }"
                        enabled="{= !${state>/isBusy} &amp;&amp; !${state>/saveInFlight} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onSaveDetail"
                        tooltip="{i18n>objectSave}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                </Button>

                <Button icon="sap-icon://delete"
                        text="{= ${view>/deleteChecklistConfirmArmed} ? ${i18n>deleteArmCancelButton} : ${i18n>deleteButton} }"
                        type="{= ${view>/deleteChecklistConfirmArmed} ? 'Transparent' : 'Reject' }"
                        visible="{parts:[{path:'state>/mode'},{path:'selected>/root/id'}], formatter:'.formatDeleteChecklistVisible'}"
                        enabled="{= !${state>/isBusy} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onArmDeleteChecklist"
                        tooltip="{= ${view>/deleteChecklistConfirmArmed} ? ${i18n>deleteArmCancelButton} : ${i18n>deleteButton} }"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </Button>

                <Button icon="sap-icon://accept"
                        text="{i18n>deleteConfirmButton}"
                        type="Reject"
                        visible="{= ${view>/deleteChecklistConfirmArmed} &amp;&amp; ${state>/mode} === 'EDIT' &amp;&amp; !!${selected>/root/id} &amp;&amp; ${selected>/root/id} !== '__CREATE' }"
                        enabled="{= !${state>/isBusy} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onConfirmDeleteChecklist"
                        tooltip="{i18n>deleteConfirmButton}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </Button>

                <Button icon="sap-icon://chain-link"
                        type="Transparent"
                        press=".onCopyDetailLink"
                        tooltip="{i18n>detailCopyLinkTooltip}"
                        enabled="{= !${state>/isBusy} }"
                        class="rnvRipple"
                        visible="{path:'selected>/root/id', formatter:'.formatCopyLinkVisible'}">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </Button>

                <Button icon="sap-icon://full-screen"
                        type="Transparent"
                        press=".onToggleDetailFullscreen"
                        tooltip="{i18n>detailFullscreenTooltip}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </Button>

                <Button icon="sap-icon://inspection"
                        text="{i18n>validateButton}"
                        visible="{= ${state>/mode} !== 'READ' }"
                        enabled="{= !${state>/isBusy} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onValidateChecklist"
                        tooltip="{i18n>validateButton}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </Button>

                <Button icon="sap-icon://status-inactive"
                        text="{i18n>statusDraft}"
                        visible="{= ${state>/mode} === 'EDIT' }"
                        press=".onChangeChecklistStatus"
                        tooltip="{i18n>statusDraft}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                    <customData><core:CustomData key="targetStatus" value="DRAFT"/></customData>
                </Button>

                <Button icon="sap-icon://status-critical"
                        text="{i18n>statusRegistered}"
                        visible="{= ${state>/mode} === 'EDIT' }"
                        press=".onChangeChecklistStatus"
                        tooltip="{i18n>statusRegistered}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                    <customData><core:CustomData key="targetStatus" value="REGISTERED"/></customData>
                </Button>

                <Button icon="sap-icon://status-positive"
                        text="{i18n>statusClosed}"
                        visible="{= ${state>/mode} === 'EDIT' }"
                        press=".onChangeChecklistStatus"
                        tooltip="{i18n>statusClosed}"
                        class="rnvRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                    <customData><core:CustomData key="targetStatus" value="CLOSED"/></customData>
                </Button>

                <ToolbarSpacer/>
            </OverflowToolbar>
        </VBox>

        <Text text="{i18n>detailControlHint}"
              class="detailRailHint sapUiTinyMarginTop"
              visible="{layout>/personalization/showHints}"/>
    </VBox>
</core:FragmentDefinition>
