<mvc:View
    controllerName="sap_ui5.controller.Analytics"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        showHeader="false"
        enableScrolling="true"
        class="pageTransparent"
        busy="{view>/busy}"
        busyIndicatorDelay="0">
        <content>
            <VBox class="appContent analyticsScreenContent" renderType="Bare">
                <VBox class="glassCard analyticsHeroCard" renderType="Bare">
                    <VBox class="analyticsHeroCopy" renderType="Bare">
                        <Text text="{i18n>analyticsScreenEyebrow}" class="workflowEyebrow"/>
                        <Title text="{i18n>workflowAnalyticsTitle}" level="H2" class="analyticsScreenTitle"/>
                        <Text text="{i18n>analyticsScreenSubtitle}" class="analyticsScreenSubtitle"/>
                    </VBox>

                    <HBox class="analyticsHeroActions" renderType="Bare" wrap="Wrap">
                        <Button
                            text="{i18n>retryButton}"
                            icon="sap-icon://refresh"
                            type="Transparent"
                            press=".onRefreshAnalytics"
                            class="brandActionBtn brandActionGhost"/>
                        <Button
                            text="{i18n>closeButton}"
                            icon="sap-icon://nav-back"
                            type="Emphasized"
                            press=".onCloseAnalytics"
                            class="brandActionBtn brandActionPrimary"/>
                    </HBox>
                </VBox>

                <VBox class="analyticsScreenBody" renderType="Bare">
                    <MessageStrip
                        text="{i18n>workflowAnalyticsBackendNote}"
                        type="Information"
                        showIcon="true"
                        class="rnvFeedbackStrip"/>
                    <MessageStrip
                        text="{view>/error}"
                        type="Warning"
                        showIcon="true"
                        visible="{= !!${view>/error} }"
                        class="rnvFeedbackStrip rnvFeedbackWarning"/>
                    <core:Fragment fragmentName="sap_ui5.view.fragment.WorkflowAnalyticsTopline" type="XML"/>
                    <core:Fragment fragmentName="sap_ui5.view.fragment.WorkflowAnalyticsBreakdowns" type="XML"/>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
