<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="shellNotificationsPopover"
        class="glassDialog shellPopover"
        title="{i18n>shellNotificationsTitle}"
        contentWidth="23rem"
        placement="Bottom">
        <content>
            <VBox class="shellPopoverBody" renderType="Bare">
                <Text text="{i18n>shellNotificationsSubtitle}" class="shellPopoverIntro"/>
                <List
                    id="shellNotificationsList"
                    items="{appView>/shell/notifications}"
                    class="shellPopoverList"
                    showSeparators="None"
                    backgroundDesign="Transparent">
                    <items>
                        <CustomListItem>
                            <HBox class="shellNotificationItem" renderType="Bare" alignItems="Start" justifyContent="SpaceBetween">
                                <core:Icon src="{appView>icon}" class="shellNotificationIcon" decorative="true"/>
                                <VBox class="shellNotificationText" renderType="Bare">
                                    <Text text="{appView>title}" class="shellNotificationTitle"/>
                                    <Text text="{appView>text}" class="shellNotificationValue"/>
                                </VBox>
                                <ObjectStatus text="{appView>status}" state="{appView>state}" class="shellNotificationStatus"/>
                            </HBox>
                        </CustomListItem>
                    </items>
                </List>
            </VBox>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
