{
  "_version": "1.19.0",
  "sap.app": {
    "id": "PRODUCTION_CONTROL_CHECKLIST",
    "i18n": "i18n/i18n.properties",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.1"
    },
    "crossNavigation": {
      "inbounds": {
        "display": {
          "signature": {
            "parameters": {
              "id": {
                "required": false
              }
            },
            "additionalParameters": "allowed"
          },
          "semanticObject": "ProductionControlChecklist",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}"
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/Z_EHS_PRODUCTION_CONTROL_CKLT_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {},
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "resourceRoots": {
      "PRODUCTION_CONTROL_CHECKLIST": "./"
    },
    "resources": {
      "css": [
        {
          "uri": "styles/app-styles.css"
        }
      ]
    },
    "rootView": {
      "viewName": "PRODUCTION_CONTROL_CHECKLIST.views.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.71.70",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.unified": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.comp": {},
        "sap.ui.table": {},
        "sap.viz": {},
        "sap.uxap": {},
        "sap.ui.export": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "mainService": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "mainService",
        "settings": {
          "useBatch": true,
          "defaultBindingMode": "OneWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false,
          "defaultOperationMode": "Server",
          "deferredGroups": [
            "changes",
            "autosave",
            "saveFlow",
            "locks"
          ],
          "changeGroups": {
            "*": {
              "groupId": "changes",
              "single": false
            },
            "LockAcquireType": {
              "groupId": "locks",
              "single": true
            },
            "LockHeartbeatType": {
              "groupId": "locks",
              "single": true
            },
            "LockReleaseType": {
              "groupId": "locks",
              "single": true
            }
          },
          "tokenHandling": true,
          "updateMethod": "MERGE"
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "PRODUCTION_CONTROL_CHECKLIST.i18n.i18n",
          "supportedLocales": [
            "ru"
          ],
          "fallbackLocale": ""
        }
      },
      "data": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "state": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "layout": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "cache": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "masterData": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "uiState": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "selected": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "mpl": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "viewPath": "PRODUCTION_CONTROL_CHECKLIST.views",
        "controlId": "mainFcl",
        "controlAggregation": "beginColumnPages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "search",
          "target": [
            "search"
          ],
          "layout": "OneColumn"
        },
        {
          "pattern": "analytics",
          "name": "analytics",
          "target": [
            "search",
            "analytics"
          ],
          "layout": "MidColumnFullScreen"
        },
        {
          "pattern": "checklist/{id}",
          "name": "detail",
          "target": [
            "search",
            "detail"
          ],
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "pattern": "checklist/{id}/{layout}",
          "name": "detailLayout",
          "target": [
            "search",
            "detail"
          ],
          "layout": "{layout}"
        }
      ],
      "targets": {
        "search": {
          "id": "searchTargetPage",
          "viewName": "Search",
          "controlAggregation": "beginColumnPages",
          "viewLevel": 1,
          "viewId": "searchView"
        },
        "detail": {
          "id": "detailTargetPage",
          "viewName": "Detail",
          "controlAggregation": "midColumnPages",
          "viewLevel": 2,
          "viewId": "detailView"
        },
        "analytics": {
          "id": "analyticsTargetPage",
          "viewName": "Analytics",
          "controlAggregation": "endColumnPages",
          "viewLevel": 2,
          "viewId": "analyticsView"
        }
      }
    },
    "config": {
      "backendMode": "real",
      "uiContractVersion": "1.0.0"
    },
    "flexEnabled": false
  }
}
