{
  "_version": "1.21.0",
  "sap.app": {
    "id": "checklist.app",
    "type": "application",
    "title": "Checklist Application",
    "description": "Enterprise Checklist Management",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/Z_UI5_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {},
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "resources": {
      "css": [
        {
          "uri": "css/claude-hyper.css"
        }
      ]
    },
    "rootView": {
      "viewName": "checklist.app.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.71.70",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.unified": {},
        "sap.f": {},
        "sap.ui.comp": {},
        "sap.ui.table": {},
        "sap.uxap": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "mainService": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "mainService",
        "settings": {
          "useBatch": true,
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false,
          "defaultOperationMode": "Server",
          "deferredGroups": [
            "changes",
            "autosave",
            "saveFlow",
            "locks"
          ],
          "changeGroups": {
            "*": {
              "groupId": "changes",
              "single": false
            },
            "LockAcquireType": {
              "groupId": "locks",
              "single": true
            },
            "LockHeartbeatType": {
              "groupId": "locks",
              "single": true
            },
            "LockReleaseType": {
              "groupId": "locks",
              "single": true
            }
          },
          "tokenHandling": true,
          "updateMethod": "MERGE"
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "checklist.app.i18n.i18n",
          "supportedLocales": [
            "",
            "ru",
            "en",
            "en_US"
          ],
          "fallbackLocale": "ru"
        }
      },
      "data": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "state": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "layout": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "cache": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "masterData": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "uiState": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "selected": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "mpl": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "viewPath": "checklist.app.view",
        "controlId": "mainFcl",
        "controlAggregation": "beginColumnPages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "search",
          "layout": "OneColumn"
        },
        {
          "pattern": "analytics",
          "name": "analytics",
          "layout": "MidColumnFullScreen"
        },
        {
          "pattern": "access-denied/{id}",
          "name": "accessDenied",
          "layout": "MidColumnFullScreen"
        },
        {
          "pattern": "checklist/{id}",
          "name": "detail",
          "layout": "TwoColumnsMidExpanded"
        },
        {
          "pattern": "checklist/{id}/{layout}",
          "name": "detailLayout",
          "layout": "TwoColumnsMidExpanded"
        }
      ]
    },
    "config": {
      "backendMode": "real",
      "uiContractVersion": "1.0.0"
    },
    "flexEnabled": false
  }
}
