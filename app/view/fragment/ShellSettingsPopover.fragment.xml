<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="shellSettingsPopover"
        class="glassDialog shellPopover shellSettingsPopover"
        title="{i18n>shellSettingsTitle}"
        contentWidth="22rem"
        placement="Bottom">
        <content>
            <VBox class="shellPopoverBody shellSettingsBody" renderType="Bare">
                <Text text="{i18n>shellSettingsSubtitle}" class="shellPopoverIntro"/>
                <MessageStrip
                    text="{i18n>shellThemeLockedMessage}"
                    type="Information"
                    showIcon="true"
                    class="chkFeedbackStrip workflowMessageSurface"/>
            </VBox>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
