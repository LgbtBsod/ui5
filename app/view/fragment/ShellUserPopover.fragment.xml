<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="shellUserPopover"
        class="glassDialog shellPopover"
        title="{i18n>shellUserTitle}"
        contentWidth="24rem"
        placement="Bottom"
        horizontalScrolling="false"
        verticalScrolling="true">
        <content>
            <VBox class="shellPopoverBody shellUserBody" renderType="Bare">
                <Text text="{i18n>shellUserSubtitle}" class="shellPopoverIntro"/>

                <VBox class="shellUserCard" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://employee-approvals" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserCurrent}" class="shellUserLabel"/>
                    </HBox>
                    <Title text="{appView>/shell/userLabel}" level="H5"/>
                    <Text text="{= ${i18n>shellUserLoginLabel} + ': ' + ${appView>/shell/userLoginLabel} }" class="shellHelpText"/>
                    <Text text="{= ${i18n>shellUserEnvironment} + ': ' + ${appView>/shell/userEnvironmentLabel} }" class="shellHelpText"/>
                    <ObjectStatus
                        text="{appView>/shell/userSessionLabel}"
                        state="{appView>/shell/userSessionState}"
                        class="shellUserSessionStatus"/>
                    <Text text="{appView>/shell/userSummaryText}" class="shellHelpText" visible="{= !!${appView>/shell/userSummaryText} }"/>
                </VBox>

                <VBox class="shellUserCard shellUserContextCard" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://task" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserContextTitle}" class="shellUserLabel"/>
                    </HBox>
                    <HBox class="shellUserContextChips" renderType="Bare" wrap="Wrap">
                        <ObjectStatus text="{appView>/shell/routeLabel}" state="Information" class="shellContextChip"/>
                        <ObjectStatus text="{appView>/shell/layoutLabel}" state="{appView>/shell/layoutState}" class="shellContextChip"/>
                        <ObjectStatus text="{appView>/shell/modeLabel}" state="{appView>/shell/modeState}" class="shellContextChip"/>
                    </HBox>
                    <Text text="{appView>/shell/userActionHint}" class="shellHelpText"/>
                </VBox>

                <Button
                    id="shellUserPrimaryActionButton"
                    text="{appView>/shell/userActionText}"
                    icon="{appView>/shell/userActionIcon}"
                    type="{appView>/shell/userActionType}"
                    press=".onShellUserPrimaryAction"
                    visible="{appView>/shell/userActionVisible}"
                    class="shellUserActionBtn"/>

                <VBox class="shellUserCard shellUserContextCard" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://key-user-settings" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserPermissionsTitle}" class="shellUserLabel"/>
                    </HBox>
                    <List items="{appView>/shell/userPermissions}" class="shellUserPermissionList" noDataText="{i18n>shellUserPermissionsEmpty}">
                        <StandardListItem title="{appView>title}" description="{appView>description}" info="{appView>scope}" icon="sap-icon://accept" type="Inactive"/>
                    </List>
                    <Button
                        id="shellUserRefreshButton"
                        text="{i18n>shellRefreshContextButton}"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        busy="{appView>/shell/userRefreshBusy}"
                        busyIndicatorDelay="0"
                        press=".onRefreshShellUser"
                        class="shellUserActionBtn"/>
                </VBox>

                <VBox class="shellUserCard shellUserPassiveCard" renderType="Bare" visible="{= !!${appView>/shell/userActionPassiveText} }">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://synchronize" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserSessionControlTitle}" class="shellUserLabel"/>
                    </HBox>
                    <Text text="{appView>/shell/userActionPassiveText}" class="shellHelpText"/>
                </VBox>
            </VBox>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
