<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="workflowAnalyticsDialog" class="glassDialog searchAnalyticsDialog analyticsExperienceDialog" title="{i18n>workflowAnalyticsTitle}" contentWidth="58rem" contentHeight="36rem" draggable="true" resizable="true" busy="{view>/analyticsBusy}" busyIndicatorDelay="0" initialFocus="workflowAnalyticsCloseButton">
        <content>
            <VBox class="sapUiMediumMargin dialogContentShell searchAnalyticsDialogBody analyticsExperienceBody chkStack" renderType="Bare">
                <MessageStrip text="{i18n>workflowAnalyticsBackendNote}" type="Information" showIcon="true" class="sapUiTinyMarginBottom searchAnalyticsDialogInfo chkFeedbackStrip"/>
                <MessageStrip text="{view>/analyticsError}" type="Warning" showIcon="true" class="sapUiTinyMarginBottom searchAnalyticsDialogError chkFeedbackStrip chkFeedbackWarning" visible="{= !!${view>/analyticsError} }"/>
                <core:Fragment fragmentName="checklist.app.view.fragment.WorkflowAnalyticsTopline" type="XML"/>
                <core:Fragment fragmentName="checklist.app.view.fragment.WorkflowAnalyticsBreakdowns" type="XML"/>
            </VBox>
        </content>
        <endButton>
            <Button id="workflowAnalyticsCloseButton" text="{i18n>closeButton}" press=".onCloseWorkflowAnalytics"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
