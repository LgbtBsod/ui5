<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox class="detailControlBar" renderType="Bare" width="100%">

        <HBox
            class="uxStatRow detailHeroStatBoard detailHeroStatBoardCompact"
            wrap="Wrap"
            renderType="Bare">
            <customData>
                <core:CustomData key="role" value="region" writeToDom="true"/>
                <core:CustomData key="aria-label" value="{i18n>detailStatsAriaLabel}" writeToDom="true"/>
            </customData>
            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>checklistLabel}" class="sapUiTinyMarginEnd uxStatLabel"/>
                <Text text="{= ${selected>/basic/checklist_id} || ${selected>/root/checklist_id} || ${selected>/root/CHECKLIST_ID} || (${selected>/root/id} === '__CREATE' ? ${i18n>newChecklist} : '-') }" class="uxStatValue"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>overallResultLabel}" class="sapUiTinyMarginEnd uxStatLabel"/>
                <ObjectStatus
                    text="{path:'selected>/root/overall_result', formatter:'.formatBooleanResultText'}"
                    state="{path:'selected>/root/overall_result', formatter:'.formatBooleanResultState'}"
                    class="uxStatValue"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>objectStatusLabel}" class="sapUiTinyMarginEnd uxStatLabel"/>
                <ObjectStatus
                    text="{path:'selected>/root/status', formatter:'.formatLifecycleStatusText'}"
                    state="{path:'selected>/root/status', formatter:'.formatLifecycleStatusState'}"
                    class="uxStatValue"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>headerDateLabel}" class="sapUiTinyMarginEnd uxStatLabel"/>
                <Text text="{path:'selected>/basic/date', formatter:'.formatHeaderDate'}" class="uxStatValue"/>
            </HBox>

            <HBox class="uxStatChip" renderType="Bare">
                <Text text="{i18n>editMode}" class="sapUiTinyMarginEnd uxStatLabel"/>
                <Text text="{= ${state>/workflow/detail/editMode} !== 'READ' ? ${i18n>modeEdit} : ${i18n>modeRead} }" class="uxStatValue"/>
            </HBox>
        </HBox>

        <MessageStrip
            id="detailValidationSummaryStrip"
            text="{path:'state>/validationSummary', formatter:'.formatValidationSummaryText'}"
            type="Error"
            showIcon="true"
            class="sapUiTinyMarginTop sapUiTinyMarginBottom chkFeedbackStrip chkFeedbackError workflowMessageSurface"
            visible="{= ${view>/validationShown} &amp;&amp; ${state>/validationSummary/hasErrors} }">
            <link>
                <Link
                    text="{path:'state>/validationSummary', formatter:'.formatValidationSummaryLinkText'}"
                    tooltip="{i18n>requiredFieldHint}"
                    press=".onFocusFirstInvalid"/>
            </link>
        </MessageStrip>

        <VBox class="detailControlToolbar detailControlToolbarStack" renderType="Bare" width="100%">
            <HBox
                class="detailSectionAnchorRail"
                renderType="Bare"
                wrap="Wrap"
                alignItems="Center">
                <customData>
                    <core:CustomData key="role" value="navigation" writeToDom="true"/>
                    <core:CustomData key="aria-label" value="{i18n>sectionNavAriaLabel}" writeToDom="true"/>
                </customData>
                <Button text="{i18n>detailAnchorOverview}"
                        icon="sap-icon://overview-chart"
                        type="Transparent"
                        class="detailSectionAnchorBtn chkRipple"
                        tooltip="{i18n>detailAnchorOverview}"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssParticipants"/></customData>
                </Button>
                <Button text="{i18n>detailAnchorChecks}"
                        icon="sap-icon://inspection"
                        type="Transparent"
                        class="detailSectionAnchorBtn chkRipple"
                        tooltip="{i18n>detailAnchorChecks}"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssChecks"/></customData>
                </Button>
                <Button text="{i18n>detailAnchorBarriers}"
                        icon="sap-icon://warning2"
                        type="Transparent"
                        class="detailSectionAnchorBtn chkRipple"
                        tooltip="{i18n>detailAnchorBarriers}"
                        visible="{path:'selected>/basic/LPC_KEY', formatter:'.isBarriersVisibleByLpc'}"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssBarriers"/></customData>
                </Button>
                <Button text="{i18n>detailAnchorAttachments}"
                        icon="sap-icon://attachment"
                        type="Transparent"
                        class="detailSectionAnchorBtn chkRipple"
                        tooltip="{i18n>detailAnchorAttachments}"
                        press=".onJumpToDetailSection">
                    <customData><core:CustomData key="targetSection" value="ssAttachments"/></customData>
                </Button>
            </HBox>

            <OverflowToolbar
                class="detailControlRow detailControlRowTop toolbarTransparent"
                design="Transparent">
                <ObjectStatus
                    icon="sap-icon://status-in-process"
                    text="{path:'selected>/root/status', formatter:'.formatLifecycleStatusText'}"
                    state="{path:'selected>/root/status', formatter:'.formatLifecycleStatusState'}"
                    class="detailRailStatusChip statusChipSemantic"
                    tooltip="{i18n>objectStatusLabel}"/>

                <ObjectStatus icon="sap-icon://edit"
                              text="{= ${state>/isDirty} ? ${i18n>dirtyStateDirty} : ${i18n>dirtyStateSynced} }"
                              state="{= ${state>/isDirty} ? 'Warning' : 'Success' }"
                              class="detailRailStatusChip statusChipSemantic">
                    <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
                </ObjectStatus>

                <ObjectStatus icon="sap-icon://history"
                              text="{parts:[{path:'state>/workflow/detail/editMode'},{path:'state>/workflow/detail/lock/state'}], formatter:'.formatHeartbeatText'}"
                              state="{parts:[{path:'state>/workflow/detail/lock/state'},{path:'state>/workflow/detail/editMode'}], formatter:'.formatLockStateSemantic'}"
                              tooltip="{i18n>heartbeatLabel}"
                              class="detailRailStatusChip statusChipSemantic">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </ObjectStatus>

                <ObjectStatus icon="sap-icon://synchronize"
                              text="{parts:[{path:'state>/workflow/detail/editMode'},{path:'state>/workflow/detail/lock/state'},{path:'state>/autosaveState'}], formatter:'.formatAutosaveText'}"
                              state="{= ${state>/workflow/detail/editMode} !== 'EDIT' || ${state>/workflow/detail/lock/state} !== 'EDIT_LOCKED' ? 'Information' : ${state>/autosaveState} === 'ERROR' ? 'Error' : ${state>/autosaveState} === 'SAVING' ? 'Warning' : ${state>/autosaveState} === 'SAVED' ? 'Success' : 'Information' }"
                              tooltip="{i18n>autosaveLabel}"
                              class="detailRailStatusChip statusChipSemantic">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </ObjectStatus>

                <ToolbarSpacer/>

                <BusyIndicator visible="{= ${state>/ui/busy/detail} || ${state>/saveInFlight} }" size="1rem" class="sapUiTinyMarginEnd">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </BusyIndicator>

                <Button icon="sap-icon://undo"
                        text="{i18n>objectCancel}"
                        visible="{= ${state>/workflow/detail/editMode} !== 'READ' &amp;&amp; !!${state>/isDirty} }"
                        enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onCancelEditFromDetail"
                        tooltip="{i18n>objectCancelTooltip}"
                        class="actionPrioritySecondary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
                </Button>

            </OverflowToolbar>

            <OverflowToolbar
                class="detailControlRow detailControlRowActions toolbarTransparent"
                design="Transparent">
                <Button icon="sap-icon://nav-back"
                        text="{i18n>closeButton}"
                        type="Transparent"
                        enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onCloseDetail"
                        tooltip="{i18n>closeDetails}"
                        class="detailRailCloseAction actionPrioritySecondary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                </Button>

                <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.view.fragment.LockSwitchStatus" type="XML"/>

                <Button icon="sap-icon://save" type="Emphasized"
                        text="{i18n>objectSave}"
                        visible="{= ${state>/workflow/detail/editMode} !== 'READ' }"
                        enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/saveInFlight} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onSaveDetail"
                        tooltip="{i18n>objectSaveTooltip}"
                        class="actionPriorityPrimary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                </Button>

                <Button icon="sap-icon://delete"
                        text="{= ${view>/deleteChecklistConfirmArmed} ? ${i18n>deleteArmCancelButton} : ${i18n>deleteButton} }"
                        type="{= ${view>/deleteChecklistConfirmArmed} ? 'Transparent' : 'Reject' }"
                        visible="{parts:[{path:'state>/workflow/detail/editMode'},{path:'selected>/root/id'}], formatter:'.formatDeleteChecklistVisible'}"
                        enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onArmDeleteChecklist"
                        tooltip="{= ${view>/deleteChecklistConfirmArmed} ? ${i18n>deleteArmCancelButton} : ${i18n>deleteTooltip} }"
                        class="actionPriorityDanger chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </Button>

                <Button icon="sap-icon://accept"
                        text="{i18n>deleteConfirmButton}"
                        type="Reject"
                        visible="{= ${view>/deleteChecklistConfirmArmed} &amp;&amp; ${state>/workflow/detail/editMode} === 'EDIT' &amp;&amp; !!${selected>/root/id} &amp;&amp; ${selected>/root/id} !== '__CREATE' }"
                        enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onConfirmDeleteChecklist"
                        tooltip="{i18n>deleteConfirmTooltip}"
                        class="actionPriorityDanger chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </Button>

                <Button icon="sap-icon://chain-link"
                        type="Transparent"
                        press=".onCopyDetailLink"
                        tooltip="{i18n>detailCopyLinkTooltip}"
                        enabled="{= !${state>/ui/busy/detail} }"
                        class="actionPrioritySecondary chkRipple"
                        visible="{path:'selected>/root/id', formatter:'.formatCopyLinkVisible'}">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </Button>

                <Button icon="sap-icon://full-screen"
                        type="Transparent"
                        press=".onToggleDetailFullscreen"
                        tooltip="{i18n>detailFullscreenTooltip}"
                        class="actionPrioritySecondary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                </Button>

                <Button icon="sap-icon://inspection"
                        text="{i18n>validateButton}"
                        visible="{= ${state>/workflow/detail/editMode} !== 'READ' }"
                        enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
                        press=".onValidateChecklist"
                        tooltip="{i18n>validateTooltip}"
                        class="actionPrioritySecondary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
                </Button>

                <Button icon="sap-icon://status-inactive"
                        text="{i18n>statusDraft}"
                        visible="{= ${state>/workflow/detail/editMode} === 'EDIT' }"
                        press=".onChangeChecklistStatus"
                        tooltip="{i18n>statusDraftTooltip}"
                        class="actionPrioritySecondary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                    <customData><core:CustomData key="targetStatus" value="DRAFT"/></customData>
                </Button>

                <Button icon="sap-icon://status-critical"
                        text="{i18n>statusRegistered}"
                        visible="{= ${state>/workflow/detail/editMode} === 'EDIT' }"
                        press=".onChangeChecklistStatus"
                        tooltip="{i18n>statusRegisteredTooltip}"
                        class="actionPrioritySecondary chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                    <customData><core:CustomData key="targetStatus" value="REGISTERED"/></customData>
                </Button>

                <Button icon="sap-icon://status-positive"
                        text="{i18n>statusClosed}"
                        visible="{= ${state>/workflow/detail/editMode} === 'EDIT' }"
                        press=".onChangeChecklistStatus"
                        tooltip="{i18n>statusClosedTooltip}"
                        class="chkRipple">
                    <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
                    <customData><core:CustomData key="targetStatus" value="CLOSED"/></customData>
                </Button>

                <ToolbarSpacer/>
            </OverflowToolbar>
        </VBox>

    </VBox>
</core:FragmentDefinition>
