<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox class="workflowBusyOverlayCard searchCustomBusyPanel" renderType="Bare">
        <HBox class="workflowBusyOverlayHeader searchCustomBusyHeader" alignItems="Center" justifyContent="SpaceBetween" renderType="Bare">
            <Text text="{i18n>busyPanelTitle}" class="workflowBusyOverlayTitle searchCustomBusyTitle"/>
            <Text text="{i18n>busyPanelSubtitle}" class="workflowBusyOverlaySubtitle searchCustomBusySubtitle"/>
        </HBox>
        <HBox class="workflowBusyOverlayPictogramRow searchCustomBusyPictogramRow" alignItems="Center" justifyContent="Center" renderType="Bare">
            <core:Icon src="sap-icon://employee-approvals" decorative="true" class="searchBusyPictogram searchBusyPictogramOne"/>
            <core:Icon src="sap-icon://factory" decorative="true" class="searchBusyPictogram searchBusyPictogramTwo"/>
            <core:Icon src="sap-icon://inspection" decorative="true" class="searchBusyPictogram searchBusyPictogramThree"/>
            <core:Icon src="sap-icon://task" decorative="true" class="searchBusyPictogram searchBusyPictogramFour"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>
