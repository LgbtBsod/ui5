<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <BusyIndicator visible="{state>/lockOperationPending}" size="1rem" class="sapUiTinyMarginEnd">
        <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
    </BusyIndicator>
    <Switch
        id="detailEditSwitch"
        visible="{= ${state>/workflow/detail/editMode} !== 'CREATE' }"
        state="{= ${state>/workflow/detail/editMode} === 'EDIT' }"
        enabled="{= ${state>/workflow/detail/editMode} !== 'CREATE' &amp;&amp; !${state>/lockOperationPending} }"
        customTextOn=""
        customTextOff=""
        change=".onToggleEdit"
        class="accentSwitch accentSwitchEditMode chkRipple">
        <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
    </Switch>
    <ObjectStatus
        text="{parts:[{path:'state>/lockOperationText'},{path:'state>/workflow/detail/editMode'}], formatter:'.formatLockOperationText'}"
        state="{parts:[{path:'state>/workflow/detail/lock/state'},{path:'state>/workflow/detail/editMode'}], formatter:'.formatLockOperationState'}"
        class="sapUiTinyMarginBegin detailRailStatusChip">
        <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
    </ObjectStatus>
</core:FragmentDefinition>
