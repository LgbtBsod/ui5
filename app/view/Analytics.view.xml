<mvc:View
    controllerName="PRODUCTION_CONTROL_CHECKLIST.controller.Analytics"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="{i18n>workflowAnalyticsTitle}"
        showNavButton="true"
        navButtonPress=".onCloseAnalytics"
        enableScrolling="true"
        class="pageTransparent"
        busy="{view>/busy}"
        busyIndicatorDelay="0">
        <headerContent>
            <ObjectStatus
                text="{= ${view>/refreshState/status} === 'REQUESTED' ? ${i18n>analyticsRefreshQueued} : (${view>/refreshState/isRunning} ? ${i18n>analyticsRefreshRunning} : (${view>/refreshState/lastError} ? ${view>/refreshState/lastError} : (${view>/refreshState/lastSuccessAt} ? (${i18n>workflowUpdatedAt} + ': ' + ${view>/refreshState/lastSuccessAt}) : ${i18n>analyticsRefreshIdle}))) }"
                state="{= ${view>/refreshState/status} === 'ERROR' ? 'Error' : ((${view>/refreshState/status} === 'REQUESTED' || ${view>/refreshState/isRunning}) ? 'Warning' : 'Success') }"/>
            <Button
                text="{i18n>analyticsRefreshButton}"
                icon="sap-icon://refresh"
                type="Emphasized"
                enabled="{= !${view>/refreshBusy} &amp;&amp; !${view>/refreshState/isRunning} &amp;&amp; ${view>/refreshState/status} !== 'REQUESTED' }"
                press=".onRefreshAnalytics"/>
        </headerContent>

        <subHeader>
            <OverflowToolbar design="Transparent">
                <Label text="{i18n>analyticsSourceFilterLabel}" labelFor="analyticsSourceSwitch"/>
                <SegmentedButton
                    id="analyticsSourceSwitch"
                    selectedKey="{view>/selectedSource}"
                    selectionChange=".onSelectAnalyticsSource">
                    <items>
                        <SegmentedButtonItem key="ALL" text="{i18n>analyticsSourceAll}"/>
                        <SegmentedButtonItem key="WEB" text="{i18n>analyticsSourceWeb}"/>
                        <SegmentedButtonItem key="INTEGRATION" text="{i18n>analyticsSourceIntegration}"/>
                    </items>
                </SegmentedButton>
                <ToolbarSpacer/>
                <Label text="{i18n>analyticsYearLabel}" labelFor="analyticsYearSelect"/>
                <Select
                    id="analyticsYearSelect"
                    width="10rem"
                    selectedKey="{view>/selectedYear}"
                    change=".onSelectAnalyticsYear"
                    items="{view>/availableYears}">
                    <core:Item key="{view>key}" text="{view>text}"/>
                </Select>
                <Button text="{i18n>analyticsPresetCurrent}" type="Transparent" press=".onApplyAnalyticsYearPreset">
                    <customData><core:CustomData key="preset" value="CURRENT"/></customData>
                </Button>
                <Button text="{i18n>analyticsPresetPrevious}" type="Transparent" press=".onApplyAnalyticsYearPreset">
                    <customData><core:CustomData key="preset" value="PREVIOUS"/></customData>
                </Button>
                <Button text="{i18n>analyticsPresetYtd}" type="Transparent" press=".onApplyAnalyticsYearPreset">
                    <customData><core:CustomData key="preset" value="YTD"/></customData>
                </Button>
                <Label text="{i18n>analyticsCompareYearLabel}" labelFor="analyticsCompareYearInput"/>
                <Input
                    id="analyticsCompareYearInput"
                    width="8rem"
                    type="Text"
                    value="{path: 'view>/compareYear', mode: 'OneWay'}"
                    showValueHelp="true"
                    valueState="{view>/compareYearValueState}"
                    valueStateText="{view>/compareYearValueStateText}"
                    maxLength="4"
                    valueHelpRequest=".onOpenAnalyticsCompareYearHelp"
                    change=".onChangeAnalyticsCompareYear"/>
            </OverflowToolbar>
        </subHeader>

        <content>
            <VBox class="appContent analyticsScreenContent" renderType="Bare">
                <VBox class="glassCard analyticsHeroCard" renderType="Bare">
                    <Text text="{i18n>analyticsScreenEyebrow}" class="workflowEyebrow"/>
                    <Title text="{i18n>workflowAnalyticsTitle}" level="H2" class="analyticsScreenTitle"/>
                    <Text text="{i18n>analyticsScreenSubtitle}" class="analyticsScreenSubtitle"/>
                </VBox>

                <VBox class="analyticsScreenBody" renderType="Bare">
                    <MessageStrip
                        text="{i18n>workflowAnalyticsBackendNote}"
                        type="Information"
                        showIcon="true"
                        class="chkFeedbackStrip"/>
                    <MessageStrip
                        text="{view>/error}"
                        type="Warning"
                        showIcon="true"
                        visible="{= !!${view>/error} }"
                        class="chkFeedbackStrip chkFeedbackWarning"/>
                    <MessageStrip
                        text="{= ${view>/refreshState/status} === 'REQUESTED' ? ${i18n>analyticsRefreshQueued} : (${view>/refreshState/isRunning} ? (${i18n>analyticsRefreshRunning} + ': ' + (${view>/refreshState/lastMessage} || '')) : (${view>/refreshState/lastError} ? ${view>/refreshState/lastError} : '')) }"
                        type="Information"
                        showIcon="true"
                        visible="{= ${view>/refreshState/status} === 'REQUESTED' || !!${view>/refreshState/isRunning} || !!${view>/refreshState/lastError} }"
                        class="chkFeedbackStrip"/>
                    <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.view.fragment.WorkflowAnalyticsTopline" type="XML"/>
                    <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.view.fragment.WorkflowAnalyticsBreakdowns" type="XML"/>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
