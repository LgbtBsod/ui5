<mvc:View
    controllerName="checklist.app.controller.App"
    displayBlock="true"
    class="chkApp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:cc="checklist.app.control"
    xmlns:f="sap.f">

    <VBox class="chkSkin appShell appLayoutSingle" fitContainer="true" width="100%">
        <cc:AppShellHeader
            eyebrow="{i18n>shellEyebrow}"
            productName="{i18n>shellProductName}"
            contextSubtitle="{appView>/shell/contextSubtitle}"
            routeLabel="{appView>/shell/routeLabel}"
            layoutLabel="{appView>/shell/layoutLabel}"
            layoutState="{appView>/shell/layoutState}"
            modeLabel="{appView>/shell/modeLabel}"
            modeState="{appView>/shell/modeState}"
            notificationsText="{i18n>shellNotificationsTitle}"
            helpText="{i18n>shellHelpTitle}"
            settingsText="{i18n>shellSettingsTitle}"
            analyticsText="{i18n>workflowAnalyticsButton}"
            userLabel="{appView>/shell/userLabel}"
            userIcon="{appView>/shell/userIcon}"
            notificationsTooltip="{i18n>shellNotificationsTooltip}"
            helpTooltip="{i18n>shellHelpTooltip}"
            settingsTooltip="{i18n>shellSettingsTooltip}"
            analyticsTooltip="{i18n>workflowAnalyticsTitle}"
            userTooltip="{appView>/shell/userTooltip}"
            dark="{appView>/isDark}"
            themeTooltip="{= ${appView>/isDark} ? ${i18n>themeSwitchToLight} : ${i18n>themeSwitchToDark} }"
            notificationsPress=".onOpenShellNotifications"
            helpPress=".onOpenShellHelp"
            settingsPress=".onOpenShellSettings"
            analyticsPress=".onOpenShellAnalytics"
            themePress=".onToggleTheme"
            userPress=".onOpenShellUserMenu"/>

        <MessageStrip
            id="globalFeedbackBanner"
            text="{state>/ui/feedback/banner/global/text}"
            type="{path:'state>/ui/feedback/banner/global/severity', formatter:'.formatGlobalBannerType'}"
            showIcon="true"
            visible="{state>/ui/feedback/banner/global/visible}"
            class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTop appFeedbackBanner chkFeedbackStrip">
            <link>
                <Link
                    text="{i18n>retryNowButton}"
                    visible="{= !!${state>/ui/feedback/banner/global/retryAction} }"
                    press=".onGlobalBannerRetry"/>
            </link>
        </MessageStrip>

        <HBox
            class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTop sapUiTinyMarginBottom appFeedbackCorrelation"
            alignItems="Center"
            renderType="Bare"
            visible="{= !!${state>/ui/feedback/banner/global/correlationId} }">
            <Text text="{i18n>correlationIdLabel}" class="sapUiTinyMarginEnd"/>
            <Input
                value="{state>/ui/feedback/banner/global/correlationId}"
                editable="false"
                width="18rem"
                class="sapUiTinyMarginEnd"/>
            <Button
                text="{i18n>copyButton}"
                type="Transparent"
                press=".onCopyFeedbackCorrelationId"/>
        </HBox>

        <f:FlexibleColumnLayout
            id="mainFcl"
            class="appRootFcl"
            layout="{= ${state>/layout} || 'OneColumn' }"
            backgroundDesign="Transparent">
            <f:beginColumnPages>
                <mvc:XMLView id="searchPaneHost" class="searchPaneCenterShell" viewName="checklist.app.view.Search" width="100%"/>
            </f:beginColumnPages>
            <f:midColumnPages>
                <mvc:XMLView id="detailPaneHost" viewName="checklist.app.view.Detail" width="100%"/>
                <mvc:XMLView id="analyticsPaneHost" viewName="checklist.app.view.Analytics" width="100%"/>
                <mvc:XMLView id="accessDeniedPaneHost" viewName="checklist.app.view.AccessDenied" width="100%"/>
            </f:midColumnPages>
        </f:FlexibleColumnLayout>
    </VBox>

</mvc:View>
