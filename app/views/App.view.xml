<mvc:View
    controllerName="PRODUCTION_CONTROL_CHECKLIST.controller.App"
    displayBlock="true"
    class="chkApp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:cc="PRODUCTION_CONTROL_CHECKLIST.controls"
    xmlns:f="sap.f">

    <VBox
        class="chkSkin appShell appLayoutSingle"
        fitContainer="true"
        width="100%">
        <VBox id="appShellHeaderHost" class="appContent appShellHeaderHost" renderType="Bare">
            <cc:AppShellHeader
                eyebrow="{shell>/shell/eyebrow}"
                productName="{shell>/shell/productName}"
                contextSubtitle="{shell>/shell/contextSubtitle}"
                userLabel="{shell>/shell/userLabel}"
                userIcon="{shell>/shell/userIcon}"
                showHelp="false"
                settingsTooltip="{i18n>shellSettingsTooltip}"
                analyticsTooltip="{i18n>workflowAnalyticsTitle}"
                userTooltip="{shell>/shell/userTooltip}"
                settingsPress=".onOpenShellSettings"
                analyticsPress=".onOpenShellAnalytics"
                userPress=".onOpenShellUserMenu"/>
        </VBox>

        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.AppFeedbackBanners" type="XML"/>

        <HBox
            id="feedbackCorrelationRegion"
            class="appFeedbackCorrelation"
            alignItems="Center"
            renderType="Bare"
            visible="{parts:[{path:'state>/ui/feedback/banner/global/correlationId'},{path:'state>/ui/feedback/banner/global/scope'}], formatter:'.formatGlobalBannerCorrelationVisible'}">
            <customData>
                <core:CustomData key="aria-labelledby" value="correlationIdLabel" writeToDom="true"/>
            </customData>
            <Label id="correlationIdLabel" text="{i18n>correlationIdLabel}" labelFor="correlationIdInput" class="appFeedbackCorrelationLabel"/>
            <Input
                id="correlationIdInput"
                value="{state>/ui/feedback/banner/global/correlationId}"
                editable="false"
                width="18rem"
                class="appFeedbackCorrelationInput"/>
            <Button
                text="{i18n>copyButton}"
                type="Transparent"
                tooltip="{i18n>copyCorrelationIdTooltip}"
                press=".onCopyFeedbackCorrelationId"/>
        </HBox>

        <VBox id="mainContentHost" renderType="Bare" fitContainer="true">
            <f:FlexibleColumnLayout
                id="mainFcl"
                class="appRootFcl appRootFclTransparent"
                layout="{= ${shell>/layout} || 'OneColumn' }"
                />
        </VBox>
    </VBox>

</mvc:View>
