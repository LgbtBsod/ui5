<mvc:View
    controllerName="PRODUCTION_CONTROL_CHECKLIST.controller.App"
    displayBlock="true"
    class="chkApp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:cc="PRODUCTION_CONTROL_CHECKLIST.controls"
    xmlns:f="sap.f">

    <VBox
        class="chkSkin appShell appLayoutSingle"
        fitContainer="true"
        width="100%">
        <VBox id="appShellHeaderHost" class="appContent appShellHeaderHost" renderType="Bare">
            <cc:AppShellHeader
                eyebrow="{appView>/shell/eyebrow}"
                productName="{appView>/shell/productName}"
                contextSubtitle="{appView>/shell/contextSubtitle}"
                userLabel="{appView>/shell/userLabel}"
                userIcon="{appView>/shell/userIcon}"
                showHelp="false"
                settingsTooltip="{i18n>shellSettingsTooltip}"
                analyticsTooltip="{i18n>workflowAnalyticsTitle}"
                userTooltip="{appView>/shell/userTooltip}"
                settingsPress=".onOpenShellSettings"
                analyticsPress=".onOpenShellAnalytics"
                userPress=".onOpenShellUserMenu"/>
        </VBox>

        <MessageStrip
            id="globalFeedbackBanner"
            text="{state>/ui/feedback/banner/global/text}"
            type="{path:'state>/ui/feedback/banner/global/severity', formatter:'.formatGlobalBannerType'}"
            showIcon="true"
            visible="{parts:[{path:'state>/ui/feedback/banner/global/visible'},{path:'state>/ui/feedback/banner/global/scope'}], formatter:'.formatGlobalBannerVisible'}"
            class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTop appFeedbackBanner chkFeedbackStrip">
            <link>
                <Link
                    text="{i18n>retryNowButton}"
                    visible="{= !!${state>/ui/feedback/banner/global/retryAction} }"
                    press=".onGlobalBannerRetry"/>
            </link>
        </MessageStrip>

        <MessageStrip
            id="routeFeedbackBanner"
            text="{state>/ui/feedback/banner/route/text}"
            type="{path:'state>/ui/feedback/banner/route/severity', formatter:'.formatGlobalBannerType'}"
            showIcon="true"
            visible="{parts:[{path:'state>/ui/feedback/banner/route/visible'},{path:'state>/ui/feedback/banner/route/scope'}], formatter:'.formatRouteBannerVisible'}"
            class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTop appFeedbackBanner chkFeedbackStrip workflowMessageSurface"/>

        <HBox
            id="feedbackCorrelationRegion"
            class="appFeedbackCorrelation"
            alignItems="Center"
            renderType="Bare"
            ariaLabelledBy="correlationIdLabel"
            visible="{parts:[{path:'state>/ui/feedback/banner/global/correlationId'},{path:'state>/ui/feedback/banner/global/scope'}], formatter:'.formatGlobalBannerCorrelationVisible'}">
            <Label id="correlationIdLabel" text="{i18n>correlationIdLabel}" labelFor="correlationIdInput" class="sapUiTinyMarginEnd"/>
            <Input
                id="correlationIdInput"
                value="{state>/ui/feedback/banner/global/correlationId}"
                editable="false"
                width="18rem"
                class="sapUiTinyMarginEnd"/>
            <Button
                text="{i18n>copyButton}"
                type="Transparent"
                tooltip="{i18n>copyCorrelationIdTooltip}"
                press=".onCopyFeedbackCorrelationId"/>
        </HBox>

        <VBox id="mainContentHost" renderType="Bare" fitContainer="true">
            <f:FlexibleColumnLayout
                id="mainFcl"
                class="appRootFcl appRootFclTransparent"
                layout="{= ${state>/layout} || 'OneColumn' }"
                />
        </VBox>
    </VBox>

</mvc:View>
