<mvc:View
    controllerName="PRODUCTION_CONTROL_CHECKLIST.controller.App"
    displayBlock="true"
    class="chkApp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:cc="PRODUCTION_CONTROL_CHECKLIST.controls"
    xmlns:f="sap.f">

    <VBox
        class="chkSkin appShell appLayoutSingle"
        fitContainer="true"
        width="100%">
        <customData>
            <core:CustomData key="role" value="application" writeToDom="true"/>
            <core:CustomData key="aria-label" value="{i18n>appRootAriaLabel}" writeToDom="true"/>
        </customData>
        <VBox class="appContent appShellHeaderHost" renderType="Bare">
            <customData>
                <core:CustomData key="role" value="banner" writeToDom="true"/>
            </customData>
            <cc:AppShellHeader
                eyebrow="{appView>/shell/eyebrow}"
                productName="{appView>/shell/productName}"
                contextSubtitle="{appView>/shell/contextSubtitle}"
                routeLabel="{appView>/shell/routeLabel}"
                settingsText="{i18n>shellSettingsTitle}"
                analyticsText="{i18n>workflowAnalyticsButton}"
                userLabel="{appView>/shell/userLabel}"
                userIcon="{appView>/shell/userIcon}"
                showHelp="false"
                showThemeToggle="false"
                settingsTooltip="{i18n>shellSettingsTooltip}"
                analyticsTooltip="{i18n>workflowAnalyticsTitle}"
                userTooltip="{appView>/shell/userTooltip}"
                settingsPress=".onOpenShellSettings"
                analyticsPress=".onOpenShellAnalytics"
                userPress=".onOpenShellUserMenu"/>
        </VBox>

        <MessageStrip
            id="globalFeedbackBanner"
            text="{state>/ui/feedback/banner/global/text}"
            type="{path:'state>/ui/feedback/banner/global/severity', formatter:'.formatGlobalBannerType'}"
            showIcon="true"
            visible="{state>/ui/feedback/banner/global/visible}"
            class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTop appFeedbackBanner chkFeedbackStrip">
            <link>
                <Link
                    text="{i18n>retryNowButton}"
                    visible="{= !!${state>/ui/feedback/banner/global/retryAction} }"
                    press=".onGlobalBannerRetry"/>
            </link>
        </MessageStrip>

        <HBox
            class="appFeedbackCorrelation"
            alignItems="Center"
            renderType="Bare"
            visible="{= !!${state>/ui/feedback/banner/global/correlationId} }">
            <customData>
                <core:CustomData key="role" value="region" writeToDom="true"/>
                <core:CustomData key="aria-label" value="{i18n>correlationIdLabel}" writeToDom="true"/>
            </customData>
            <Label text="{i18n>correlationIdLabel}" labelFor="correlationIdInput" class="sapUiTinyMarginEnd"/>
            <Input
                id="correlationIdInput"
                value="{state>/ui/feedback/banner/global/correlationId}"
                editable="false"
                width="18rem"
                class="sapUiTinyMarginEnd"/>
            <Button
                text="{i18n>copyButton}"
                type="Transparent"
                tooltip="{i18n>copyCorrelationIdTooltip}"
                press=".onCopyFeedbackCorrelationId"/>
        </HBox>

        <VBox renderType="Bare" fitContainer="true">
            <customData>
                <core:CustomData key="role" value="main" writeToDom="true"/>
                <core:CustomData key="aria-label" value="{i18n>mainContentAriaLabel}" writeToDom="true"/>
            </customData>
            <f:FlexibleColumnLayout
                id="mainFcl"
                class="appRootFcl appRootFclTransparent"
                layout="{= ${state>/layout} || 'OneColumn' }"
                />
        </VBox>
    </VBox>

</mvc:View>
