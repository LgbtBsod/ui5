<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <HBox
        id="searchResultsSummaryRail"
        renderType="Bare"
        visible="{= ${view>/hasSearched} }"
        class="searchResultsSummaryRail workbenchToolbarSurface sectionToolbarSurface">
        <VBox renderType="Bare" class="searchResultsSummaryMeta">
            <Label text="{i18n>resultsLabel}" class="searchResultsSummaryLabel"/>
            <Text
                text="{parts: [{path: 'view>/resultCount'}, {path: 'view>/hasRows'}], formatter: '.formatSearchResultsCompactText'}"
                class="searchResultsSummaryText"/>
        </VBox>
        <ToolbarSpacer/>
        <ObjectStatus
            text="{parts: [{path: 'view>/selectionCount'}, {path: 'view>/selectedRowDisplayId'}], formatter: '.formatSearchSelectionSummary'}"
            state="Information"
            class="searchResultsSummarySelection"/>
        <Button
            visible="{view>/resultsToolbarNavVisible}"
            text="{i18n>searchBackToResultsToolbarButton}"
            type="Transparent"
            tooltip="{i18n>searchBackToResultsToolbarTooltip}"
            press=".onScrollSearchResultsToolbarAnchor"
            class="searchResultsSummaryUpButton searchToolbarNavBtn searchToolbarNavBtnUp chkRipple"/>
    </HBox>
</core:FragmentDefinition>
