<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ObjectStatus
        text="{= ${i18n>analyticsSelectedYear} + ': ' + ${view>/analytics/selectedYear} }"
        state="{path: 'view>/analytics/selectedYear', formatter: '.formatAnalyticsSourceState'}"
        class="analyticsMetaChip statusChipSemantic"/>
    <ObjectStatus
        text="{= ${i18n>analyticsCompareYearLabel} + ': ' + ${view>/analytics/compareYear} }"
        state="{path: 'view>/analytics/compareYear', formatter: '.formatAnalyticsCompareYearState'}"
        class="analyticsMetaChip statusChipSemantic"/>
    <ObjectStatus
        text="{= ${i18n>workflowUpdatedAt} + ': ' + (${view>/analytics/refreshedAt} || '-') }"
        state="{path: 'view>/analytics/refreshedAt', formatter: '.formatAnalyticsSelectedYearState'}"
        class="analyticsMetaChip statusChipSemantic"/>
</core:FragmentDefinition>
