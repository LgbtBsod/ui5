<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox class="workflowBusyOverlayCard workflowBusySurface searchCustomBusyPanel" renderType="Bare">
        <VBox class="workflowBusyOverlayHeader searchCustomBusyHeader searchCustomBusyHeaderCentered" alignItems="Center" justifyContent="Center" renderType="Bare">
            <Text text="{i18n>busyPanelTitle}" class="workflowBusyOverlayTitle searchCustomBusyTitle"/>
        </VBox>
        <HBox class="workflowBusyOverlayPictogramRow searchCustomBusyPictogramRow" alignItems="Center" justifyContent="Center" renderType="Bare">
            <core:Icon src="sap-icon://employee-approvals" decorative="true" class="searchBusyPictogram searchBusyPictogramOne"/>
            <core:Icon src="sap-icon://factory" decorative="true" class="searchBusyPictogram searchBusyPictogramTwo"/>
            <core:Icon src="sap-icon://inspection" decorative="true" class="searchBusyPictogram searchBusyPictogramThree"/>
            <core:Icon src="sap-icon://task" decorative="true" class="searchBusyPictogram searchBusyPictogramFour"/>
            <core:Icon src="sap-icon://shipping-status" decorative="true" class="searchBusyPictogram searchBusyPictogramFive"/>
            <core:Icon src="sap-icon://process" decorative="true" class="searchBusyPictogram searchBusyPictogramSix"/>
            <core:Icon src="sap-icon://activity-items" decorative="true" class="searchBusyPictogram searchBusyPictogramSeven"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>
