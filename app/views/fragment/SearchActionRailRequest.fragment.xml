<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <core:InvisibleText id="searchBackendTopA11y" text="{i18n>searchBackendTopLabel}"/>
    <core:InvisibleText id="searchMaxRowsA11y" text="{i18n>searchMaxResultsLabel}"/>
    <core:InvisibleText id="searchModeA11y" text="{i18n>searchModeLabel}"/>
    <Label
        text="{i18n>searchBackendTopLabel}"
        labelFor="backendTopInput"
        class="searchToolbarFieldLabel">
        <layoutData>
            <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/>
        </layoutData>
    </Label>
    <Input
        id="backendTopInput"
        value="{state>/searchBackendTop}"
        type="Number"
        placeholder="{i18n>searchBackendTopLabel}"
        width="5rem"
        change=".onBackendTopChange"
        submit=".onBackendTopChange"
        ariaLabelledBy="searchBackendTopA11y"
        class="backendTopInput">
        <layoutData>
            <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="true" minWidth="4rem"/>
        </layoutData>
    </Input>
    <Label
        text="{i18n>searchMaxResultsLabel}"
        labelFor="maxRowsInput"
        class="searchToolbarFieldLabel">
        <layoutData>
            <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/>
        </layoutData>
    </Label>
    <Input
        id="maxRowsInput"
        value="{state>/searchMaxResults}"
        type="Number"
        placeholder="{i18n>searchMaxResultsLabel}"
        width="5rem"
        change=".onMaxRowsChange"
        submit=".onMaxRowsChange"
        ariaLabelledBy="searchMaxRowsA11y"
        class="maxRowsInput">
        <layoutData>
            <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="true" minWidth="4rem"/>
        </layoutData>
    </Input>
    <ObjectStatus
        text="{path: 'state>/searchMode', formatter: '.formatSearchModeChipText'}"
        state="Information"
        class="searchModeStatusChip statusChipSemantic">
        <layoutData>
            <OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/>
        </layoutData>
    </ObjectStatus>
    <Switch
        state="{= ${state>/searchMode} === 'LOOSE' }"
        change=".onSearchModeToggle"
        customTextOn=""
        customTextOff=""
        class="appAccentSwitch searchModeToggleSwitch">
        <layoutData>
            <OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/>
        </layoutData>
    </Switch>
</core:FragmentDefinition>
