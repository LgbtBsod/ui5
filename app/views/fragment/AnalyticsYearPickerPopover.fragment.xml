<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout.cssgrid">
    <ResponsivePopover
        id="analyticsYearPickerPopover"
        class="appDialogSurface shellPopover analyticsYearPickerPopover"
        contentWidth="19rem"
        placement="Bottom">
        <customHeader>
            <Bar class="analyticsYearPickerHeader">
                <contentLeft>
                    <Button icon="sap-icon://navigation-left-arrow" type="Transparent" press=".onNavigateAnalyticsYearPickerBack" class="analyticsYearPickerNav analyticsYearPickerNavBack"/>
                </contentLeft>
                <contentMiddle>
                    <Title text="{view>/yearPicker/rangeLabel}" level="H6" class="analyticsYearPickerTitle"/>
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".onNavigateAnalyticsYearPickerForward" class="analyticsYearPickerNav analyticsYearPickerNavForward"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="analyticsYearPickerBody" renderType="Bare">
                <layout:CSSGrid
                    width="100%"
                    gridTemplateColumns="repeat(4, minmax(0, 1fr))"
                    gridGap="0.5rem"
                    items="{view>/yearPicker/items}">
                    <Button
                        text="{view>text}"
                        type="{= ${view>selected} ? 'Emphasized' : 'Transparent' }"
                        press=".onSelectAnalyticsYearFromPicker"
                        class="analyticsYearPickerButton">
                        <customData>
                            <core:CustomData key="year" value="{view>key}"/>
                        </customData>
                    </Button>
                </layout:CSSGrid>
            </VBox>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
