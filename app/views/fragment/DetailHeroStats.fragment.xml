<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <HBox id="detailHeroStatsRegion" class="uxStatRow detailHeroStatBoard detailHeroStatBoardCompact" wrap="Wrap" renderType="Bare">
        <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>checklistLabel}" class="uxStatLabel detailHeroStatLabel"/><Text text="{= ${selected>/basic/checklist_id} || ${selected>/root/checklist_id} || ${selected>/root/CHECKLIST_ID} || (${view>/isCreateMode} ? ${i18n>newChecklist} : '-') }" class="uxStatValue"/></HBox>
        <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>overallResultLabel}" class="uxStatLabel detailHeroStatLabel"/><ObjectStatus text="{path:'selected>/root/overall_result', formatter:'.formatBooleanResultText'}" state="{path:'selected>/root/overall_result', formatter:'.formatBooleanResultState'}" class="uxStatValue"/></HBox>
        <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>objectStatusLabel}" class="uxStatLabel detailHeroStatLabel"/><ObjectStatus text="{path:'selected>/root/status', formatter:'.formatLifecycleStatusText'}" state="{path:'selected>/root/status', formatter:'.formatLifecycleStatusState'}" class="uxStatValue"/></HBox>
        <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>headerDateLabel}" class="uxStatLabel detailHeroStatLabel"/><Text text="{path:'selected>/basic/date', formatter:'.formatHeaderDate'}" class="uxStatValue"/></HBox>
    </HBox>
</core:FragmentDefinition>
