<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <HBox id="detailHeroStatsRegion" class="uxStatRow detailHeroStatBoard detailHeroStatBoardCompact" wrap="Wrap" renderType="Bare">
    <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>checklistLabel}" class="uxStatLabel detailHeroStatLabel"/><Text text="{= ${detail>/current/basic/checklist_id} || (${view>/isCreateMode} ? ${i18n>newChecklist} : '-') }" class="uxStatValue"/></HBox>
    <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>overallResultLabel}" class="uxStatLabel detailHeroStatLabel"/><ObjectStatus text="{path:'detail>/current/root/overall_result', formatter:'.formatBooleanResultText'}" state="{path:'detail>/current/root/overall_result', formatter:'.formatBooleanResultState'}" class="uxStatValue"/></HBox>
    <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>objectStatusLabel}" class="uxStatLabel detailHeroStatLabel"/><ObjectStatus text="{path:'detail>/current/root/status', formatter:'.formatLifecycleStatusText'}" state="{path:'detail>/current/root/status', formatter:'.formatLifecycleStatusState'}" class="uxStatValue"/></HBox>
    <HBox class="uxStatChip" renderType="Bare" visible="{path:'detail>/current/root/integrationFlag', formatter:'.formatIntegrationVisible'}"><Text text="{i18n>sourceLabel}" class="uxStatLabel detailHeroStatLabel"/><ObjectStatus text="{path:'detail>/current/root/integrationFlag', formatter:'.formatIntegrationText'}" state="Information" class="uxStatValue"/></HBox>
    <HBox class="uxStatChip" renderType="Bare"><Text text="{i18n>headerDateLabel}" class="uxStatLabel detailHeroStatLabel"/><Text text="{path:'detail>/current/basic/date', formatter:'.formatHeaderDate'}" class="uxStatValue"/></HBox>
    </HBox>
</core:FragmentDefinition>
