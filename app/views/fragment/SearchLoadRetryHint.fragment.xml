<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <HBox
        class="searchLoadRetryRow sapUiTinyMarginTop"
        alignItems="Center"
        justifyContent="SpaceBetween"
        renderType="Bare"
        visible="{state>/loadError}">
        <Text
            text="{= ${state>/networkOnline} === false ? ${i18n>searchOfflineMessage} : ${i18n>searchTimeoutMessage} }"
            class="modeHintText"/>
        <Button
            text="{i18n>searchRetryAction}"
            type="Transparent"
            press=".onRetrySearchLoad"
            enabled="{= !${state>/ui/busy/searchTable} }"/>
    </HBox>
</core:FragmentDefinition>
