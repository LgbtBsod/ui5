<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table">
    <VBox width="100%" modelContextChange=".onChecklistRowsBindingChange">
        <t:Table
            visible="{parts:[{path:'appView>/isPhoneViewport'},{path:'view>/narrowDetailViewport'},{path:'selected>'},{path:'view>ignoreNarrowViewport'}], formatter:'.isRuntimeDesktopTableVisible'}"
            rows="{selected>}"
            selectionMode="None"
            visibleRowCountMode="Fixed"
            visibleRowCount="{view>desktopVisibleRowCount}"
            rowHeight="48"
            class="{view>desktopTableClass}">
            <t:columns>
                <t:Column width="3rem">
                    <Label text=""/>
                    <t:template>
                        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailRowSelectionCell" type="XML"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <Label text="{path:'view>labelKeys/number', formatter:'.formatI18nByKey'}"/>
                    <t:template>
                        <Input value="{parts:[{path:'selected>.'},{path:'view>kind'}], formatter:'.formatDetailRowNumber'}" editable="false"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <Label text="{path:'view>labelKeys/text', formatter:'.formatI18nByKey'}"/>
                    <t:template>
                        <Input value="{selected>text}" change=".onRowValueChange" editable="{= ${state>/workflow/detail/editMode} !== 'READ' }"/>
                    </t:template>
                </t:Column>
                <t:Column width="8rem">
                    <Label text="{path:'view>labelKeys/status', formatter:'.formatI18nByKey'}"/>
                    <t:template>
                        <Switch state="{selected>result}" change=".onRowStateChange" enabled="{= ${state>/workflow/detail/editMode} !== 'READ' }" class="{view>resultSwitchClass}"/>
                    </t:template>
                </t:Column>
                <t:Column>
                    <Label text="{path:'view>labelKeys/comment', formatter:'.formatI18nByKey'}"/>
                    <t:template>
                        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailRowCommentCell" type="XML"/>
                    </t:template>
                </t:Column>
                <t:Column width="10rem" hAlign="Center" visible="{= ${state>/workflow/detail/editMode} !== 'READ' }">
                    <Label text="{i18n>rowActionsLabel}" class="tableActionHeaderLabel"/>
                    <t:template>
                        <Button icon="sap-icon://delete" text="{i18n>rowActionDelete}" type="Transparent" press=".onDeleteExpandedRow" class="tableRowActionBtn tableRowActionBtnDanger">
                            <customData>
                                <core:CustomData key="rowKind" value="{view>deleteActionKind}"/>
                            </customData>
                        </Button>
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>

        <Table
            items="{selected>}"
            class="{view>mobileTableClass}"
            growing="true"
            growingThreshold="50"
            growingScrollToLoad="true"
            visible="{parts:[{path:'appView>/isPhoneViewport'},{path:'view>/narrowDetailViewport'},{path:'selected>'},{path:'view>ignoreNarrowViewport'}], formatter:'.isRuntimePhoneTableVisible'}"
            noDataText="{path:'view>noDataKey', formatter:'.formatI18nByKey'}">
            <columns>
                <Column width="3rem"><Text text=""/></Column>
                <Column><Text text="{path:'view>labelKeys/number', formatter:'.formatI18nByKey'}"/></Column>
                <Column><Text text="{path:'view>labelKeys/text', formatter:'.formatI18nByKey'}"/></Column>
                <Column><Text text="{path:'view>labelKeys/status', formatter:'.formatI18nByKey'}"/></Column>
                <Column><Text text="{path:'view>labelKeys/comment', formatter:'.formatI18nByKey'}"/></Column>
                <Column width="10rem" hAlign="Center" visible="{= ${state>/workflow/detail/editMode} !== 'READ' }">
                    <Label text="{i18n>rowActionsLabel}" class="tableActionHeaderLabel"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailRowSelectionCell" type="XML"/>
                        <Input value="{parts:[{path:'selected>.'},{path:'view>kind'}], formatter:'.formatDetailRowNumber'}" editable="false"/>
                        <Input value="{selected>text}" change=".onRowValueChange" editable="{= ${state>/workflow/detail/editMode} !== 'READ' }"/>
                        <Switch state="{selected>result}" change=".onRowStateChange" enabled="{= ${state>/workflow/detail/editMode} !== 'READ' }" class="{view>resultSwitchClass}"/>
                        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailRowCommentCell" type="XML"/>
                        <Button icon="sap-icon://delete" text="{i18n>rowActionDelete}" type="Transparent" press=".onDeleteExpandedRow" visible="{= ${state>/workflow/detail/editMode} !== 'READ' }" class="tableRowActionBtn tableRowActionBtnDanger">
                            <customData>
                                <core:CustomData key="rowKind" value="{view>deleteActionKind}"/>
                            </customData>
                        </Button>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
