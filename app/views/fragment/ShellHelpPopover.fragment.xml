<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="shellHelpPopover"
        class="appDialogSurface shellPopover"
        title="{i18n>shellHelpTitle}"
        contentWidth="24rem"
        placement="Bottom">
        <content>
            <VBox class="shellPopoverBody shellHelpBody" renderType="Bare">
                <Text text="{i18n>shellHelpSubtitle}" class="shellPopoverIntro"/>

                <VBox class="shellHelpItem" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://task" decorative="true" class="shellItemIcon"/>
                        <Title text="{i18n>shellHelpTipSearchTitle}" level="H6"/>
                    </HBox>
                    <Text text="{i18n>shellHelpTipSearchText}" class="shellHelpText"/>
                </VBox>

                <VBox class="shellHelpItem" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://edit" decorative="true" class="shellItemIcon"/>
                        <Title text="{i18n>shellHelpTipEditTitle}" level="H6"/>
                    </HBox>
                    <Text text="{i18n>shellHelpTipEditText}" class="shellHelpText"/>
                </VBox>

                <VBox class="shellHelpItem" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://synchronize" decorative="true" class="shellItemIcon"/>
                        <Title text="{i18n>shellHelpTipThemeTitle}" level="H6"/>
                    </HBox>
                    <Text text="{i18n>shellHelpTipThemeText}" class="shellHelpText"/>
                </VBox>
            </VBox>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
