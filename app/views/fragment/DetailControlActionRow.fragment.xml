<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <OverflowToolbar id="detailControlActionRow" class="detailControlRow detailControlRowActions toolbarTransparent" design="Transparent">

        <Button
            id="detailCloseButton"
            icon="sap-icon://nav-back"
            text="{i18n>closeButton}"
            type="Transparent"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onCloseDetail"
            tooltip="{i18n>closeDetails}"
            class="detailRailActionBtn detailRailCloseAction appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow"/>
            </layoutData>
        </Button>

        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.LockSwitchStatus" type="XML"/>

        <Button
            icon="sap-icon://save"
            type="Emphasized"
            text="{i18n>objectSave}"
            visible="{path:'state>/workflow/detail/editMode', formatter:'.formatEditActionVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/saveInFlight} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onSaveDetail"
            tooltip="{i18n>objectSaveTooltip}"
            class="detailRailActionBtn appActionPrimary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow"/>
            </layoutData>
        </Button>

        <Button
            icon="sap-icon://inspection"
            text="{i18n>validateButton}"
            visible="{path:'state>/workflow/detail/editMode', formatter:'.formatEditActionVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onValidateChecklist"
            tooltip="{i18n>validateTooltip}"
            class="detailRailActionBtn appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="High"/>
            </layoutData>
        </Button>
        <Button
            icon="sap-icon://delete"
            text="{= ${view>/deleteChecklistConfirmArmed} ? ${i18n>deleteArmCancelButton} : ${i18n>deleteButton} }"
            type="{= ${view>/deleteChecklistConfirmArmed} ? 'Transparent' : 'Reject' }"
            visible="{parts:[{path:'state>/workflow/detail/editMode'},{path:'state>/activeObjectId'}], formatter:'.formatDeleteChecklistVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onArmDeleteChecklist"
            tooltip="{= ${view>/deleteChecklistConfirmArmed} ? ${i18n>deleteArmCancelButton} : ${i18n>deleteTooltip} }"
            class="detailRailActionBtn appActionDanger appActionReject chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
            </layoutData>
        </Button>

        <Button
            icon="sap-icon://accept"
            text="{i18n>deleteConfirmButton}"
            type="Reject"
            visible="{parts:[{path:'view>/deleteChecklistConfirmArmed'},{path:'state>/workflow/detail/editMode'},{path:'state>/activeObjectId'}], formatter:'.formatDeleteChecklistConfirmVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onConfirmDeleteChecklist"
            tooltip="{i18n>deleteConfirmTooltip}"
            class="detailRailActionBtn appActionDanger appActionReject chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
            </layoutData>
        </Button>

        <Button
            icon="sap-icon://status-inactive"
            text="{i18n>statusDraft}"
            visible="{path:'state>/workflow/detail/editMode', formatter:'.formatEditActionVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} &amp;&amp; !${state>/validationSummary/hasErrors} }"
            press=".onChangeChecklistStatus"
            tooltip="{= ${state>/validationSummary/hasErrors} ? ${i18n>validationSummaryTitle} : ${i18n>statusDraftTooltip} }"
            class="detailRailActionBtn appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
            </layoutData>
            <customData>
                <core:CustomData key="targetStatus" value="{view>/statusTargets/DRAFT}"/>
            </customData>
        </Button>

        <Button
            icon="sap-icon://status-critical"
            text="{i18n>statusInProcess}"
            visible="{path:'state>/workflow/detail/editMode', formatter:'.formatEditActionVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} &amp;&amp; !${state>/validationSummary/hasErrors} }"
            press=".onChangeChecklistStatus"
            tooltip="{= ${state>/validationSummary/hasErrors} ? ${i18n>validationSummaryTitle} : ${i18n>statusInProcessTooltip} }"
            class="detailRailActionBtn appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
            </layoutData>
            <customData>
                <core:CustomData key="targetStatus" value="{view>/statusTargets/IN_PROCESS}"/>
            </customData>
        </Button>

        <Button
            icon="sap-icon://status-positive"
            text="{i18n>statusCompleted}"
            visible="{path:'state>/workflow/detail/editMode', formatter:'.formatEditActionVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} &amp;&amp; !${state>/validationSummary/hasErrors} }"
            press=".onChangeChecklistStatus"
            tooltip="{= ${state>/validationSummary/hasErrors} ? ${i18n>validationSummaryTitle} : ${i18n>statusCompletedTooltip} }"
            class="detailRailActionBtn appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
            </layoutData>
            <customData>
                <core:CustomData key="targetStatus" value="{view>/statusTargets/COMPLETED}"/>
            </customData>
        </Button>

        <Button
            icon="sap-icon://decline"
            text="{i18n>statusCancelled}"
            visible="{path:'state>/workflow/detail/editMode', formatter:'.formatEditActionVisible'}"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onChangeChecklistStatus"
            tooltip="{i18n>statusCancelledTooltip}"
            class="detailRailActionBtn appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="AlwaysOverflow"/>
            </layoutData>
            <customData>
                <core:CustomData key="targetStatus" value="{view>/statusTargets/CANCELLED}"/>
            </customData>
        </Button>

        <Button
            icon="sap-icon://chain-link"
            text="{i18n>detailCopyLinkTooltip}"
            type="Transparent"
            press=".onCopyDetailLink"
            tooltip="{i18n>detailCopyLinkTooltip}"
            enabled="{= !${state>/ui/busy/detail} }"
            class="detailRailActionBtn appActionSecondary chkRipple"
            visible="{path:'state>/activeObjectId', formatter:'.formatCopyLinkVisible'}">
            <layoutData>
                <OverflowToolbarLayoutData priority="Low"/>
            </layoutData>
        </Button>

        <Button
            icon="sap-icon://full-screen"
            text="{i18n>detailFullscreenTooltip}"
            type="Transparent"
            press=".onToggleDetailFullscreen"
            tooltip="{i18n>detailFullscreenTooltip}"
            class="detailRailActionBtn appActionSecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="Low"/>
            </layoutData>
        </Button>
    </OverflowToolbar>
</core:FragmentDefinition>
