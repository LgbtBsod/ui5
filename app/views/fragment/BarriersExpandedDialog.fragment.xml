<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        class="glassDialog governedDialog expandedRowsDialog"
        id="barriersExpandedDialog"
        title="{i18n>barriersExpandedTitle}"
        contentWidth="72rem"
        contentHeight="30rem"
        draggable="true"
        resizable="true"
        stretchOnPhone="true"
        initialFocus="barriersExpandedCloseButton">
        <customData>
            <core:CustomData key="dialogKind" value="barrier"/>
        </customData>
        <content>
            <VBox
                binding="{view>/detailExpandedDialogs/barriers/tableSpec}"
                class="expandedDialogContent dialogContentShell governedDialogContent tableDialogBody workflowBusyScope workflowBusyScopeDialog"
                renderType="Bare">
                <VBox class="workflowBusyOverlayShell workflowBusyOverlayShellDialog" renderType="Bare" visible="{view>/barriersExpandedBusy}">
                    <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowBusyOverlay" type="XML"/>
                </VBox>
                <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.DetailChecklistRowsTable" type="XML"/>
            </VBox>
        </content>
        <beginButton>
            <Button id="barriersExpandedCloseButton" text="{i18n>closeButton}" icon="sap-icon://nav-back" press=".onCloseExpandedRows" class="expandedRowsCloseButton">
                <customData>
                    <core:CustomData key="dialogKind" value="barrier"/>
                </customData>
            </Button>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
