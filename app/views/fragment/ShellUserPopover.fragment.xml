<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover
        id="shellUserPopover"
        class="appDialogSurface shellPopover shellUserPopover"
        title="{i18n>shellUserTitle}"
        contentWidth="30rem"
        placement="Bottom"
        horizontalScrolling="false"
        verticalScrolling="false">
        <content>
            <VBox class="shellPopoverBody shellUserBody" renderType="Bare">
                <Text text="{i18n>shellUserSubtitle}" class="shellPopoverIntro"/>

                <VBox class="shellUserCard" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://employee-approvals" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserCurrent}" class="shellUserLabel"/>
                    </HBox>
                    <Title text="{shell>/shell/userLabel}" level="H5"/>
                    <Text
                        text="{= ${i18n>shellUserLoginLabel} + ': ' + ${shell>/shell/userLoginLabel} }"
                        class="shellHelpText"
                        visible="{= !!${shell>/shell/userLoginLabel} }"/>
                    <Text text="{= ${i18n>shellUserEnvironment} + ': ' + ${shell>/shell/userEnvironmentLabel} }" class="shellHelpText"/>
                    <ObjectStatus
                        text="{shell>/shell/userSessionLabel}"
                        state="{shell>/shell/userSessionState}"
                        class="shellUserSessionStatus"/>
                    <Text text="{shell>/shell/userSummaryText}" class="shellHelpText" visible="{= !!${shell>/shell/userSummaryText} }"/>
                </VBox>

                <VBox class="shellUserCard shellUserContextCard" renderType="Bare">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://task" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserContextTitle}" class="shellUserLabel"/>
                    </HBox>
                    <HBox class="shellUserContextChips" renderType="Bare" wrap="Wrap">
                        <ObjectStatus text="{shell>/shell/routeLabel}" state="Information" class="shellContextChip"/>
                    </HBox>
                    <Text text="{shell>/shell/userActionHint}" class="shellHelpText"/>
                </VBox>

                <Button
                    id="shellUserPrimaryActionButton"
                    text="{shell>/shell/userActionText}"
                    icon="{shell>/shell/userActionIcon}"
                    type="{shell>/shell/userActionType}"
                    press=".onShellUserPrimaryAction"
                    visible="{shell>/shell/userActionVisible}"
                    class="shellUserActionBtn shellUserPrimaryActionBtn"/>

                <VBox class="shellUserCard shellUserContextCard workflowBusyScope" renderType="Bare">
                    <VBox class="workflowBusyOverlayShell workflowBusyOverlayShellInset" renderType="Bare" visible="{shell>/shell/userRefreshBusy}">
                        <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowBusyOverlay" type="XML"/>
                    </VBox>
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://key-user-settings" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserPermissionsTitle}" class="shellUserLabel"/>
                    </HBox>
                    <List items="{shell>/shell/userPermissions}" class="shellUserPermissionList shellUserPermissionsList" noDataText="{i18n>shellUserPermissionsEmpty}">
                        <StandardListItem title="{shell>title}" description="{shell>description}" info="{shell>scope}" icon="sap-icon://accept" type="Inactive"/>
                    </List>
                    <Button
                        id="shellUserRefreshButton"
                        text="{i18n>shellRefreshContextButton}"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        enabled="{= !${shell>/shell/userRefreshBusy} }"
                        press=".onRefreshShellUser"
                        class="shellUserActionBtn shellUserRefreshActionBtn"/>
                </VBox>

                <VBox class="shellUserCard shellUserPassiveCard" renderType="Bare" visible="{= !!${shell>/shell/userActionPassiveText} }">
                    <HBox class="shellItemHeader" renderType="Bare" alignItems="Center">
                        <core:Icon src="sap-icon://synchronize" decorative="true" class="shellItemIcon"/>
                        <Text text="{i18n>shellUserSessionControlTitle}" class="shellUserLabel"/>
                    </HBox>
                    <Text text="{shell>/shell/userActionPassiveText}" class="shellHelpText"/>
                </VBox>
            </VBox>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
