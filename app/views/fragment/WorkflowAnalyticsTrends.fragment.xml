<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">
    <IconTabFilter key="trends" text="{i18n>analyticsTrendsTab}" icon="sap-icon://line-chart">
        <VBox class="analyticsBreakdownSection" renderType="Bare">
            <Panel headerText="{i18n>analyticsComparisonChartTitle}" expandable="false" class="analyticsChartPanel analyticsPanelSurface">
                <content>
                    <OverflowToolbar design="Transparent" class="analyticsComparisonToolbar workbenchToolbarSurface analyticsControlToolbar">
                        <Label text="{i18n>analyticsCompareMetricLabel}" labelFor="analyticsComparisonMetricSelect" class="analyticsControlLabel analyticsComparisonMetricLabel"/>
                        <Select id="analyticsComparisonMetricSelect" width="16rem" selectedKey="{view>/comparisonMetric}" change=".onSelectAnalyticsMetric" class="analyticsControlSelect analyticsComparisonMetricSelect">
                            <items>
                                <core:Item key="FAILED_CHECKS" text="{i18n>analyticsMetricFailedChecks}"/>
                                <core:Item key="FAILED_BARRIERS" text="{i18n>analyticsMetricFailedBarriers}"/>
                                <core:Item key="FAILED_CHECKLISTS" text="{i18n>analyticsMetricFailedChecklistCount}"/>
                                <core:Item key="FAILED_BARRIER_CHECKLISTS" text="{i18n>analyticsMetricFailedBarrierChecklistCount}"/>
                                <core:Item key="TOTAL" text="{i18n>analyticsMetricTotal}"/>
                            </items>
                        </Select>
                        <ToolbarSpacer class="analyticsToolbarSpacer analyticsComparisonToolbarSpacer"/>
                        <ObjectStatus
                            text="{= ${view>/selectedYear} + ' vs ' + ${view>/compareYear} }"
                            state="Information"
                            class="analyticsComparisonScopeChip statusChipSemantic"/>
                    </OverflowToolbar>
                    <MessageStrip
                        text="{view>/compareYearHintText}"
                        type="Information"
                        showIcon="true"
                        visible="{= !${view>/compareYearHasData} &amp;&amp; !!${view>/compareYearHintText} }"
                        class="chkFeedbackStrip analyticsInlineHintStrip"/>
                    <viz:VizFrame vizType="line" width="100%" height="18rem" uiConfig="{applicationSet:'fiori'}" visible="{view>/analytics/hasCharts/comparisonChart}">
                        <viz:dataset>
                            <vizData:FlattenedDataset data="{view>/analytics/comparisonChartRows}">
                                <vizData:dimensions>
                                    <vizData:DimensionDefinition name="{i18n>analyticsMonth}" value="{view>monthLabel}"/>
                                </vizData:dimensions>
                                <vizData:measures>
                                    <vizData:MeasureDefinition name="{i18n>analyticsSelectedYear}" value="{view>selectedValue}"/>
                                    <vizData:MeasureDefinition name="{i18n>analyticsCompareYearLabel}" value="{view>compareValue}"/>
                                </vizData:measures>
                            </vizData:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <vizFeeds:FeedItem id="analyticsComparisonValueFeed" uid="valueAxis" type="Measure"/>
                            <vizFeeds:FeedItem id="analyticsComparisonCategoryFeed" uid="categoryAxis" type="Dimension"/>
                        </viz:feeds>
                    </viz:VizFrame>
                    <Text text="{i18n>analyticsNoData}" visible="{= !${view>/analytics/hasCharts/comparisonChart} }" class="analyticsChartEmpty analyticsChartEmptySpaced"/>
                </content>
            </Panel>
            <Panel headerText="{i18n>analyticsMonthlyMatrixTitle}" expandable="false" class="analyticsChartPanel analyticsPanelSurface analyticsPanelSurfaceSpaced">
                <content>
                    <ScrollContainer width="100%" horizontal="true" vertical="false" focusable="false" class="analyticsMatrixScroller">
                        <Table items="{view>/analytics/monthlyMatrixRows}" class="flatEditorTable detailAttachmentTable analyticsMatrixTable" noDataText="{i18n>analyticsNoData}">
                            <columns>
                                <Column width="13rem"><Text text="{i18n>analyticsMetricColumn}"/></Column>
                                <Column width="6rem"><Text text="{i18n>analyticsYearColumn}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortJan}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortFeb}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortMar}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortApr}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortMay}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortJun}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortJul}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortAug}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortSep}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortOct}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortNov}"/></Column>
                                <Column width="5rem"><Text text="{i18n>analyticsMonthShortDec}"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem class="analyticsMatrixRow">
                                    <cells>
                                        <Text
                                            text="{path: 'view>metricKey', formatter: '.formatAnalyticsMatrixMetricLabel'}"
                                            class="analyticsMatrixMetricCell"/>
                                        <ObjectStatus text="{view>yearLabel}" state="Information" class="analyticsMatrixYearChip statusChipSemantic"/>
                                        <Text text="{view>jan}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>feb}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>mar}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>apr}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>may}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>jun}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>jul}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>aug}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>sep}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>oct}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>nov}" class="analyticsMatrixValueCell"/>
                                        <Text text="{view>dec}" class="analyticsMatrixValueCell"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </ScrollContainer>
                </content>
            </Panel>
        </VBox>
    </IconTabFilter>
</core:FragmentDefinition>
