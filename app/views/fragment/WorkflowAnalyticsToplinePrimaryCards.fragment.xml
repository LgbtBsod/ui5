<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox class="kpiCard analyticsToplineCard kpiTotal" renderType="Bare">
        <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
            <core:Icon src="sap-icon://task" class="kpiLabelIcon" decorative="true"/>
            <Text text="{i18n>kpiVisible}" class="kpiLabel"/>
        </HBox>
        <Title text="{view>/analytics/total}" level="H3" class="kpiValue analyticsValue"/>
        <Text text="{view>/analytics/sourceText}" class="analyticsToplineSubhead"/>
        <Text text="{= ${i18n>analyticsDeltaShort} + ' ' + ${view>/analytics/compareYear} + ': ' + ${view>/analytics/deltas/total/text} }" class="analyticsToplineMeta"/>
    </VBox>

    <VBox class="kpiCard analyticsToplineCard kpiCardDanger kpiFailed" renderType="Bare">
        <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
            <core:Icon src="sap-icon://inspection" class="kpiLabelIcon" decorative="true"/>
            <Text text="{i18n>kpiFailedChecks}" class="kpiLabel"/>
        </HBox>
        <Title text="{view>/analytics/failedChecks}" level="H3" class="kpiValue analyticsValue"/>
        <Text text="{= ${i18n>analyticsFailedChecklistCount} + ': ' + ${view>/analytics/failedChecklistCount} }" class="analyticsToplineSubhead"/>
        <Text text="{= ${i18n>analyticsDeltaShort} + ' ' + ${view>/analytics/compareYear} + ': ' + ${view>/analytics/deltas/failedChecks/text} }" class="analyticsToplineMeta"/>
    </VBox>

    <VBox class="kpiCard analyticsToplineCard kpiCardWarning kpiBarriers" renderType="Bare">
        <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
            <core:Icon src="sap-icon://alert" class="kpiLabelIcon" decorative="true"/>
            <Text text="{i18n>kpiFailedBarriers}" class="kpiLabel"/>
        </HBox>
        <Title text="{view>/analytics/failedBarriers}" level="H3" class="kpiValue analyticsValue"/>
        <Text text="{= ${i18n>analyticsFailedBarrierChecklistCount} + ': ' + ${view>/analytics/failedBarrierChecklistCount} }" class="analyticsToplineSubhead"/>
        <Text text="{= ${i18n>analyticsDeltaShort} + ' ' + ${view>/analytics/compareYear} + ': ' + ${view>/analytics/deltas/failedBarriers/text} }" class="analyticsToplineMeta"/>
    </VBox>
</core:FragmentDefinition>
