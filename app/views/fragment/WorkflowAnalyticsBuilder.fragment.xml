<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">
    <IconTabFilter key="builder" text="{i18n>analyticsBuilderTab}" icon="sap-icon://vertical-bar-chart">
        <VBox class="analyticsBreakdownSection" renderType="Bare">
            <Panel headerText="{view>/builderChartTitle}" expandable="false" class="analyticsChartPanel analyticsPanelSurface">
                <content>
                    <MessageStrip text="{view>/builderSourceHintText}" type="Information" showIcon="true" visible="{= !!${view>/builderSourceHintText} }" class="chkFeedbackStrip analyticsInlineHintStrip"/>
                    <OverflowToolbar design="Transparent" class="analyticsBuilderToolbar workbenchToolbarSurface analyticsControlToolbar">
                        <Label text="{i18n>analyticsBuilderDimensionLabel}" labelFor="analyticsBuilderDimensionSelect" class="analyticsControlLabel analyticsBuilderDimensionLabel"/>
                        <Select id="analyticsBuilderDimensionSelect" width="14rem" selectedKey="{view>/builderDimension}" change=".onSelectAnalyticsBuilderDimension" items="{view>/builderDimensionOptions}" class="analyticsControlSelect analyticsBuilderDimensionSelect">
                            <core:Item key="{view>key}" text="{view>text}"/>
                        </Select>
                        <Label text="{i18n>analyticsBuilderMetricLabel}" labelFor="analyticsBuilderMetricSelect" class="analyticsControlLabel analyticsBuilderMetricLabel"/>
                        <Select id="analyticsBuilderMetricSelect" width="16rem" selectedKey="{view>/builderMetric}" change=".onSelectAnalyticsBuilderMetric" items="{view>/builderMetricOptions}" class="analyticsControlSelect analyticsBuilderMetricSelect">
                            <core:Item key="{view>key}" text="{view>text}"/>
                        </Select>
                        <ToolbarSpacer class="analyticsToolbarSpacer analyticsBuilderToolbarSpacer"/>
                        <ObjectStatus text="{= ${view>/selectedSource} + ' / ' + ${view>/selectedYear} }" state="Information" class="analyticsBuilderScopeChip statusChipSemantic"/>
                    </OverflowToolbar>
                    <viz:VizFrame vizType="{view>/builderVizType}" width="100%" height="18rem" uiConfig="{applicationSet:'fiori'}" selectData=".onDrilldownAnalyticsBuilder" visible="{view>/builderChartHasData}">
                        <viz:dataset>
                            <vizData:FlattenedDataset data="{view>/builderChartRows}">
                                <vizData:dimensions><vizData:DimensionDefinition name="Dimension" value="{view>label}"/></vizData:dimensions>
                                <vizData:measures><vizData:MeasureDefinition name="Value" value="{view>value}"/></vizData:measures>
                            </vizData:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Value"/>
                            <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Dimension"/>
                        </viz:feeds>
                    </viz:VizFrame>
                    <Text text="{i18n>analyticsBuilderNoData}" visible="{= !${view>/builderChartHasData} }" class="analyticsChartEmpty"/>
                </content>
            </Panel>
        </VBox>
    </IconTabFilter>
</core:FragmentDefinition>
