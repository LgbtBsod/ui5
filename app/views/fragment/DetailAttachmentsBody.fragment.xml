<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:unified="sap.ui.unified">
    <VBox
        id="attachmentDropZone"
        visible="{view>/attachmentMetaEditable}"
        class="detailAttachmentDropZone">
        <VBox class="detailAttachmentDropZoneActions">
            <HBox renderType="Bare" class="detailAttachmentPickerRow">
                <Title level="H6" text="{i18n>attachmentDropZoneTitle}" class="detailAttachmentPickerTitle"/>
                <Text text="{i18n>attachmentDropZoneHint}" class="modeHintText detailAttachmentPickerText"/>
                <Link
                    text="{i18n>uploadAttachment}"
                    press=".onOpenAttachmentPicker"
                    enabled="{view>/attachmentActionsEnabled}"
                    class="detailAttachmentPickerLink"/>
            </HBox>
            <HBox
                renderType="Bare"
                class="detailAttachmentMetaRow"
                visible="{view>/attachmentMetaEditable}">
                <Label text="{i18n>attachmentCategoryLabel}" labelFor="attachmentCategorySelect" class="detailAttachmentMetaLabel"/>
                <Select
                    id="attachmentCategorySelect"
                    width="12rem"
                    selectedKey="{view>/attachmentCategoryKey}"
                    enabled="{view>/attachmentMetaEditable}"
                    items="{ path: 'masterData>/attachmentTypes', templateShareable: true }"
                    class="detailAttachmentCategorySelect">
                    <core:Item key="{masterData>key}" text="{masterData>text}"/>
                </Select>
            </HBox>
            <unified:FileUploader
                id="attachmentUploader"
                buttonOnly="true"
                sameFilenameAllowed="true"
                useMultipart="false"
                buttonText="{i18n>uploadAttachment}"
                tooltip="{i18n>uploadAttachment}"
                enabled="{view>/attachmentActionsEnabled}"
                change=".onAttachmentUploadChange"
                class="detailAttachmentUploaderHidden"/>
        </VBox>
        <Text
            text="{parts:[{path:'masterData>/runtime/uploadPolicy/allowedExtensions'},{path:'masterData>/runtime/uploadPolicy/maxSizeMb'}], formatter:'.formatAttachmentUploadHint'}"
            class="modeHintText detailAttachmentDropZoneMeta"/>
    </VBox>

    <VBox id="attachmentDropScope" renderType="Bare" width="100%">
        <VBox id="attachmentSessionScope" renderType="Bare" width="100%" visible="{view>/showSessionAttachments}">
            <Table
                items="{view>/sessionAttachments}"
                class="flatEditorTable detailAttachmentTable detailAttachmentTableSession"
                visible="{path:'view>/sessionAttachments', formatter:'.hasRows'}"
                noDataText="{i18n>noAttachmentsData}">
                <columns>
                    <Column>
                        <Text text="{i18n>attachmentFileName}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" visible="{view>/attachmentDesktopColumnsVisible}">
                        <Text text="{i18n>attachmentCategoryLabel}"/>
                    </Column>
                    <Column width="7rem" hAlign="End">
                        <Text text="{i18n>attachmentSize}"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" visible="{view>/attachmentDesktopColumnsVisible}">
                        <Text text="{i18n>attachmentChangedOn}"/>
                    </Column>
                    <Column width="{view>/attachmentActionsColumnWidth}" hAlign="Center">
                        <Label text="{i18n>rowActionsLabel}" class="tableActionHeaderLabel"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem class="detailAttachmentRow detailAttachmentSessionRow">
                        <cells>
                            <ObjectIdentifier title="{view>FileName}" text="{view>MimeType}" class="detailAttachmentNameCell"/>
                            <Text
                                text="{parts:[{path:'view>CategoryKey'},{path:'masterData>/attachmentTypes'},{path:'view>CategoryText'}], formatter:'.formatAttachmentCategoryText'}"
                                class="detailAttachmentCategoryCell"/>
                            <Text text="{path:'view>FileSize', formatter:'.formatAttachmentSize'}" textAlign="End" class="detailAttachmentSizeCell"/>
                            <Text text="{view>ChangedOn}" class="detailAttachmentChangedCell"/>
                            <HBox renderType="Bare" class="tableRowActionBar detailAttachmentActions detailAttachmentActionCell" wrap="Wrap">
                                <Button
                                    icon="sap-icon://download"
                                    text="{i18n>rowActionDownload}"
                                    type="Transparent"
                                    press=".onOpenAttachment"
                                    class="tableRowActionBtn"/>
                                <Button
                                    icon="sap-icon://delete"
                                    text="{i18n>rowActionDelete}"
                                    type="Transparent"
                                    press=".onDeleteAttachment"
                                    visible="{view>/attachmentMetaEditable}"
                                    class="tableRowActionBtn tableRowActionBtnDanger"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <VBox id="attachmentExpandedScope" renderType="Bare" width="100%" visible="{view>/attachmentsExpanded}">
            <HBox
                class="detailEmptyStateCard workflowEmptyStateCard detailAttachmentsEmptyState"
                renderType="Bare"
                visible="{path:'view>/sessionAttachments', formatter:'.isEmptyRows'}">
                <core:Icon src="sap-icon://attachment" class="detailEmptyStateIcon workflowEmptyStateIcon"/>
                <Title text="{i18n>detailEmptyAttachmentsTitle}" level="H6" class="detailEmptyStateTitle workflowEmptyStateTitle"/>
                <Text
                text="{path:'detail>/current/root/id', formatter:'.formatAttachmentsEmptyStateText'}"
                    class="detailEmptyStateText workflowEmptyStateText"/>
            </HBox>
            <Table
                items="{view>/sessionAttachments}"
                class="flatEditorTable detailAttachmentTable"
                visible="{path:'view>/sessionAttachments', formatter:'.hasRows'}"
                noDataText="{i18n>noAttachmentsData}">
                <columns>
                    <Column>
                        <Text text="{i18n>attachmentFileName}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" visible="{view>/attachmentDesktopColumnsVisible}">
                        <Text text="{i18n>attachmentCategoryLabel}"/>
                    </Column>
                    <Column width="7rem" hAlign="End">
                        <Text text="{i18n>attachmentSize}"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" visible="{view>/attachmentDesktopColumnsVisible}">
                        <Text text="{i18n>attachmentChangedOn}"/>
                    </Column>
                    <Column width="{view>/attachmentActionsColumnWidth}" hAlign="Center">
                        <Label text="{i18n>rowActionsLabel}" class="tableActionHeaderLabel"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem class="detailAttachmentRow detailAttachmentExpandedRow">
                        <cells>
                            <ObjectIdentifier title="{view>FileName}" text="{view>MimeType}" class="detailAttachmentNameCell"/>
                            <Text
                                text="{parts:[{path:'view>CategoryKey'},{path:'masterData>/attachmentTypes'},{path:'view>CategoryText'}], formatter:'.formatAttachmentCategoryText'}"
                                class="detailAttachmentCategoryCell"/>
                            <Text text="{path:'view>FileSize', formatter:'.formatAttachmentSize'}" textAlign="End" class="detailAttachmentSizeCell"/>
                            <Text text="{view>ChangedOn}" class="detailAttachmentChangedCell"/>
                            <HBox renderType="Bare" class="tableRowActionBar detailAttachmentActions detailAttachmentActionCell" wrap="Wrap">
                                <Button
                                    icon="sap-icon://download"
                                    text="{i18n>rowActionDownload}"
                                    type="Transparent"
                                    press=".onOpenAttachment"
                                    class="tableRowActionBtn"/>
                                <Button
                                    icon="sap-icon://delete"
                                    text="{i18n>rowActionDelete}"
                                    type="Transparent"
                                    press=".onDeleteAttachment"
                                    visible="{view>/attachmentMetaEditable}"
                                    class="tableRowActionBtn tableRowActionBtnDanger"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </VBox>
</core:FragmentDefinition>
