<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:dnd="sap.ui.core.dnd">
    <VBox class="appSurfaceCard appSectionSurface detailInfoExperienceCard detailInfoBridgeCard" width="100%">
        <VBox visible="{view>/detailSkeletonBusy}" renderType="Bare">
            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.SkeletonFormSection" type="XML"/>
        </VBox>
        <VBox visible="{= !${view>/detailSkeletonBusy} }" renderType="Bare" class="appSkeletonReveal detailSectionBody detailInfoSectionBody">
            <f:GridList id="infoCardGrid" items="{path:'view>/infoCards', factory: '.infoCardFactory'}" class="infoCardGrid" showSeparators="None">
                <f:dragDropConfig>
                    <dnd:DragInfo sourceAggregation="items" enabled="true"/>
                    <dnd:DropInfo targetAggregation="items" dropPosition="Between" enabled="true" drop=".onInfoCardsDrop"/>
                </f:dragDropConfig>
            </f:GridList>
        </VBox>
    </VBox>
</core:FragmentDefinition>
