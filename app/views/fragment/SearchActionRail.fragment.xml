<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <OverflowToolbar id="searchResultsActionRail" width="100%" class="toolbarTransparent tableActionToolbar searchActionToolbarDensity searchResultsActionRail workbenchToolbarSurface actionToolbarSurface">
        <Button text="{i18n>createButton}" icon="sap-icon://task" press=".onCreate" tooltip="{i18n>searchShortcutCreate}" enabled="{= !${view>/bootstrapBusy} &amp;&amp; !${view>/createActionBusy} }" class="brandActionBtn brandActionPrimary actionPriorityPrimary searchCreateActionBtn sapUiTinyMarginEnd chkRipple">
            <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" moveToOverflow="false"/></layoutData>
        </Button>
        <Button id="searchToolbarUpButton" icon="sap-icon://navigation-up-arrow" text="{i18n>searchBackToResultsToolbarButton}" type="Emphasized" visible="{view>/resultsToolbarNavVisible}" tooltip="{i18n>searchBackToResultsToolbarTooltip}" press=".onScrollSearchResultsToolbarAnchor" class="searchToolbarNavBtn searchToolbarNavBtnUp chkRipple">
            <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" moveToOverflow="false"/></layoutData>
        </Button>
        <Button text="{i18n>copyButton}" icon="sap-icon://copy" press=".onCopy" enabled="{view>/canCopy}" tooltip="{= ${view>/selectionCount} > 1 ? ${i18n>searchCopySingleSelectionHint} : ${i18n>searchShortcutCopy} }" class="brandActionBtn brandActionGhost actionPrioritySecondary searchCopyActionBtn sapUiTinyMarginEnd chkRipple">
            <layoutData><OverflowToolbarLayoutData priority="Disappear" moveToOverflow="true"/></layoutData>
        </Button>
        <Button text="{i18n>selectVisibleButton}" icon="sap-icon://multi-select" press=".onSelectVisibleRows" enabled="{= ${view>/hasRows} &amp;&amp; !${view>/tableBusy} }" tooltip="{i18n>searchShortcutSelectVisible}" class="brandActionBtn brandActionGhost actionPrioritySecondary searchSelectVisibleActionBtn sapUiTinyMarginEnd chkRipple">
            <layoutData><OverflowToolbarLayoutData priority="AlwaysOverflow" moveToOverflow="true"/></layoutData>
        </Button>
        <Button text="{i18n>clearSelectionButton}" icon="sap-icon://sys-cancel" press=".onClearSelection" enabled="{view>/hasSelection}" tooltip="{i18n>searchShortcutClearSelection}" class="brandActionBtn brandActionGhost actionPrioritySecondary searchClearSelectionActionBtn sapUiTinyMarginEnd chkRipple">
            <layoutData><OverflowToolbarLayoutData priority="AlwaysOverflow" moveToOverflow="true"/></layoutData>
        </Button>
        <ToolbarSpacer/>
        <ObjectStatus text="{= ${view>/selectionCount} ? ${view>/selectionCount} + ' ' + ${i18n>searchSelectionUnits} : ${i18n>searchSelectionNone} }" state="{= ${view>/selectionCount} ? 'Success' : 'Information' }" class="searchSelectionStatusChip statusChipSemantic">
            <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
        </ObjectStatus>
        <Text text="{= ${i18n>searchSelectionPrimaryPrefix} + ': ' + ${view>/selectedRowDisplayId} }" visible="{view>/hasSelection}" tooltip="{view>/selectedRowDisplayId}" class="searchSelectionPrimaryId" wrapping="false">
            <layoutData><OverflowToolbarLayoutData priority="Disappear" moveToOverflow="true"/></layoutData>
        </Text>


        <core:InvisibleText id="searchBackendTopA11y" text="{i18n>searchBackendTopLabel}"/>
        <core:InvisibleText id="searchMaxRowsA11y" text="{i18n>searchMaxResultsLabel}"/>
        <core:InvisibleText id="searchModeA11y" text="{i18n>searchModeLabel}"/>
        <Title text="Search" level="H6" class="searchToolbarGroupTitle"><layoutData><OverflowToolbarLayoutData priority="NeverOverflow" moveToOverflow="false"/></layoutData></Title>
        <Label text="{i18n>searchBackendTopLabel}" labelFor="backendTopInput" class="searchToolbarFieldLabel"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/></layoutData></Label>
        <Input id="backendTopInput" value="{state>/searchBackendTop}" type="Number" placeholder="{i18n>searchBackendTopLabel}" width="5rem" change=".onBackendTopChange" submit=".onBackendTopChange" ariaLabelledBy="searchBackendTopA11y" class="backendTopInput"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="true" minWidth="4rem"/></layoutData></Input>
        <Label text="{i18n>searchMaxResultsLabel}" labelFor="maxRowsInput" class="searchToolbarFieldLabel"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/></layoutData></Label>
        <Input id="maxRowsInput" value="{state>/searchMaxResults}" type="Number" placeholder="{i18n>searchMaxResultsLabel}" width="5rem" change=".onMaxRowsChange" submit=".onMaxRowsChange" ariaLabelledBy="searchMaxRowsA11y" class="maxRowsInput"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="true" minWidth="4rem"/></layoutData></Input>
        <ObjectStatus text="{path: 'state>/searchMode', formatter: '.formatSearchModeChipText'}" state="Information" class="searchModeStatusChip statusChipSemantic"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/></layoutData></ObjectStatus>
        <Switch state="{= ${state>/searchMode} === 'LOOSE' }" change=".onSearchModeToggle" customTextOn="" customTextOff="" class="appAccentSwitch searchModeToggleSwitch"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/></layoutData></Switch>
        <ToolbarSpacer/>
        <Button text="{i18n>searchSortButton}" icon="sap-icon://sort" type="Transparent" press=".onOpenSearchSortDialog" tooltip="{i18n>searchSortButton}" class="brandActionGhost actionPrioritySecondary searchSortButton chkRipple"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/></layoutData></Button>
        <Button text="{i18n>searchGroupButton}" icon="sap-icon://group-2" type="Transparent" press=".onOpenSearchGroupDialog" tooltip="{i18n>searchGroupButton}" class="brandActionGhost actionPrioritySecondary searchGroupButton chkRipple"><layoutData><OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/></layoutData></Button>
        <MenuButton text="{i18n>exportMenuButton}" enabled="{view>/canExport}" tooltip="{i18n>searchShortcutExport}" class="brandActionBtn brandActionGhost actionPrioritySecondary searchExportMenuBtn chkRipple" icon="sap-icon://excel-attachment">
            <menu>
                <Menu itemSelected=".onExportMenuAction">
                    <items>
                        <MenuItem text="{i18n>exportModeScreen}" icon="sap-icon://table-view"><customData><core:CustomData key="entity" value="screen"/></customData></MenuItem>
                        <MenuItem text="{i18n>exportBarriersButton}" icon="sap-icon://warning2"><customData><core:CustomData key="entity" value="barrier"/></customData></MenuItem>
                        <MenuItem text="{i18n>exportChecksButton}" icon="sap-icon://inspection"><customData><core:CustomData key="entity" value="check"/></customData></MenuItem>
                    </items>
                </Menu>
            </menu>
        </MenuButton>
    </OverflowToolbar>
</core:FragmentDefinition>
