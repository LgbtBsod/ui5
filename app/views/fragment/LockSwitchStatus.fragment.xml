<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <BusyIndicator visible="{state>/lockOperationPending}" size="1rem" class="detailControlBusyIndicator lockStatusBusyIndicator">
        <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
    </BusyIndicator>
    <Switch
        id="detailEditSwitch"
        visible="{path:'state>/activeObjectId', formatter:'.formatPersistedActionVisible'}"
        state="{path:'state>/workflow/detail/editMode', formatter:'.formatEditSwitchState'}"
        enabled="{parts:[{path:'state>/activeObjectId'},{path:'state>/lockOperationPending'}], formatter:'.formatEditSwitchEnabled'}"
        customTextOn=""
        customTextOff=""
        change=".onToggleEdit"
        class="appAccentSwitch detailControlEditSwitch lockStatusEditSwitch">
        <layoutData><OverflowToolbarLayoutData priority="High"/></layoutData>
    </Switch>
    <ObjectStatus
        text="{parts:[{path:'state>/lockStateText'},{path:'state>/workflow/detail/editMode'}], formatter:'.formatLockStateText'}"
        state="{parts:[{path:'state>/workflow/detail/lock/state'},{path:'state>/workflow/detail/editMode'}], formatter:'.formatLockStateSemantic'}"
        class="detailRailStatusChip detailRailLockStatusChip statusChipSemantic lockStatusChip">
        <layoutData><OverflowToolbarLayoutData priority="Disappear"/></layoutData>
    </ObjectStatus>
</core:FragmentDefinition>
