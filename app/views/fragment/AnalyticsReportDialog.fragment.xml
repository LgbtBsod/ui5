<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        id="analyticsReportDialog"
        class="appDialogSurface analyticsReportDialog governedDialog"
        title="{i18n>analyticsReportDialogTitle}"
        contentWidth="42rem"
        contentHeight="28rem"
        draggable="true"
        resizable="true"
        stretchOnPhone="true"
        initialFocus="analyticsReportExportButton">
        <content>
            <VBox class="dialogBodyShell analyticsReportDialogBody dialogBusyScope" renderType="Bare" fitContainer="true">
                <VBox class="analyticsReportHero" renderType="Bare">
                    <Text text="{i18n>analyticsReportDialogEyebrow}" class="workflowEyebrow"/>
                    <Title text="{i18n>analyticsReportDialogTitle}" level="H3" class="analyticsReportTitle"/>
                    <Text text="{i18n>analyticsReportDialogSubtitle}" class="analyticsReportSubtitle"/>
                </VBox>
                <VBox class="analyticsReportScopeCard workflowEmptyStateCard" renderType="Bare">
                    <Label text="{i18n>analyticsReportCurrentScopeLabel}" class="detailMetaLabel"/>
                    <HBox class="analyticsReportScopeRail" wrap="Wrap" renderType="Bare">
                        <ObjectStatus
                            text="{= ${i18n>analyticsSourceFilterLabel} + ': ' + (${view>/selectedSource} === 'WEB' ? ${i18n>analyticsSourceWeb} : (${view>/selectedSource} === 'INTEGRATION' ? ${i18n>analyticsSourceIntegration} : ${i18n>analyticsSourceAll})) }"
                            state="None"
                            class="analyticsHeroContextChip statusChipSemantic"/>
                        <ObjectStatus
                            text="{= ${i18n>analyticsSelectedYear} + ': ' + ${view>/selectedYear} }"
                            state="{path: 'view>/selectedYear', formatter: '.formatAnalyticsSelectedYearState'}"
                            class="analyticsHeroContextChip statusChipSemantic"/>
                        <ObjectStatus
                            text="{= ${i18n>analyticsCompareYearLabel} + ': ' + ${view>/compareYear} }"
                            state="{path: 'view>/compareYear', formatter: '.formatAnalyticsCompareYearState'}"
                            class="analyticsHeroContextChip statusChipSemantic"/>
                    </HBox>
                </VBox>
                <VBox class="analyticsReportSummaryCard workflowMessageSurface" renderType="Bare">
                    <Label text="{i18n>analyticsReportSummaryLabel}" class="detailMetaLabel"/>
                    <List class="analyticsReportSummaryList" showSeparators="None">
                        <CustomListItem>
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="analyticsReportSummaryRow" renderType="Bare">
                                <Text text="{i18n>kpiVisible}" class="analyticsReportSummaryKey"/>
                                <ObjectNumber number="{view>/analytics/summary/total}" emphasized="false" class="analyticsReportSummaryValue"/>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem>
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="analyticsReportSummaryRow" renderType="Bare">
                                <Text text="{i18n>kpiFailedChecks}" class="analyticsReportSummaryKey"/>
                                <ObjectNumber number="{view>/analytics/summary/failedChecks}" emphasized="false" class="analyticsReportSummaryValue"/>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem>
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="analyticsReportSummaryRow" renderType="Bare">
                                <Text text="{i18n>kpiFailedBarriers}" class="analyticsReportSummaryKey"/>
                                <ObjectNumber number="{view>/analytics/summary/failedBarriers}" emphasized="false" class="analyticsReportSummaryValue"/>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem>
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="analyticsReportSummaryRow" renderType="Bare">
                                <Text text="{i18n>analyticsChecksSuccessRate}" class="analyticsReportSummaryKey"/>
                                <ObjectStatus text="{view>/analytics/summary/checksRate}" state="{path:'view>/analytics/summary/checksRate', formatter:'.formatRateState'}" class="analyticsReportSummaryValue"/>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem>
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="analyticsReportSummaryRow" renderType="Bare">
                                <Text text="{i18n>analyticsBarriersSuccessRate}" class="analyticsReportSummaryKey"/>
                                <ObjectStatus text="{view>/analytics/summary/barriersRate}" state="{path:'view>/analytics/summary/barriersRate', formatter:'.formatRateState'}" class="analyticsReportSummaryValue"/>
                            </HBox>
                        </CustomListItem>
                    </List>
                    <MessageStrip
                        text="{i18n>analyticsReportDialogNote}"
                        type="{path: 'view>/selectedSource', formatter: '.formatAnalyticsInfoMessageType'}"
                        showIcon="true"
                        class="chkFeedbackStrip analyticsReportHintStrip"/>
                </VBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                id="analyticsReportExportButton"
                text="{i18n>analyticsExportButton}"
                icon="sap-icon://excel-attachment"
                type="Emphasized"
                press=".onExportAnalyticsReport"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>closeButton}"
                icon="sap-icon://nav-back"
                press=".onCloseAnalyticsReportDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
