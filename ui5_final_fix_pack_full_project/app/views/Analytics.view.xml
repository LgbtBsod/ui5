<mvc:View
    controllerName="PRODUCTION_CONTROL_CHECKLIST.controller.Analytics"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="{i18n>workflowAnalyticsTitle}"
        showNavButton="true"
        navButtonPress=".onCloseAnalytics"
        enableScrolling="true"
        class="pageTransparent analyticsPage">
        <headerContent>
            <Button
                text="{i18n>analyticsReportButton}"
                icon="sap-icon://business-objects-experience"
                type="Transparent"
                press=".onOpenAnalyticsReportDialog"
                class="analyticsReportButton actionPrioritySecondary"/>
            <Button
                text="{i18n>analyticsExportButton}"
                icon="sap-icon://excel-attachment"
                type="Transparent"
                press=".onExportAnalyticsReport"
                class="analyticsExportButton actionPrioritySecondary"/>
            <ObjectStatus
                class="analyticsRefreshStatus statusChipSemantic"
                text="{parts: [{path: 'view>/refreshState/status'}, {path: 'view>/refreshState/isRunning'}, {path: 'view>/refreshState/lastError'}, {path: 'view>/refreshState/lastSuccessAt'}, {path: 'i18n>analyticsRefreshQueued'}, {path: 'i18n>analyticsRefreshRunning'}, {path: 'i18n>workflowUpdatedAt'}, {path: 'i18n>analyticsRefreshIdle'}], formatter: '.formatRefreshStatusText'}"
                state="{= ${view>/refreshState/status} === 'ERROR' ? 'Error' : ((${view>/refreshState/status} === 'REQUESTED' || ${view>/refreshState/isRunning}) ? 'Warning' : 'Success') }"/>
            <Button
                text="{i18n>analyticsRefreshButton}"
                icon="sap-icon://refresh"
                type="Emphasized"
                enabled="{= !${view>/refreshBusy} &amp;&amp; !${view>/refreshState/isRunning} &amp;&amp; ${view>/refreshState/status} !== 'REQUESTED' }"
                press=".onRefreshAnalytics"
                class="analyticsRefreshButton actionPriorityPrimary"/>
        </headerContent>

        <subHeader>
            <OverflowToolbar design="Transparent" class="analyticsFilterToolbar workbenchToolbarSurface">
                <Label text="{i18n>analyticsSourceFilterLabel}" labelFor="analyticsSourceSwitch" class="analyticsFilterLabel analyticsSourceLabel">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/>
                    </layoutData>
                </Label>
                <SegmentedButton
                    id="analyticsSourceSwitch"
                    class="analyticsSourceSwitch"
                    selectedKey="{view>/selectedSource}"
                    selectionChange=".onSelectAnalyticsSource">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" moveToOverflow="true" shrinkable="true" minWidth="12rem"/>
                    </layoutData>
                    <items>
                        <SegmentedButtonItem key="ALL" text="{i18n>analyticsSourceAll}"/>
                        <SegmentedButtonItem key="WEB" text="{i18n>analyticsSourceWeb}"/>
                        <SegmentedButtonItem key="INTEGRATION" text="{i18n>analyticsSourceIntegration}"/>
                    </items>
                </SegmentedButton>
                <ToolbarSpacer/>
                <Label text="{i18n>analyticsYearLabel}" labelFor="analyticsYearSelect" class="analyticsFilterLabel analyticsYearLabel">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/>
                    </layoutData>
                </Label>
                <HBox class="analyticsYearField" renderType="Bare" alignItems="Center">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" moveToOverflow="true" shrinkable="true" minWidth="9rem"/>
                    </layoutData>
                    <Input
                        id="analyticsYearSelect"
                        width="7rem"
                        type="Text"
                        value="{view>/selectedYear}"
                        maxLength="4"
                        liveChange=".onLiveChangeAnalyticsYear"
                        change=".onSelectAnalyticsYear"/>
                    <Button
                        icon="sap-icon://calendar"
                        type="Transparent"
                        tooltip="{i18n>analyticsYearLabel}"
                        press=".onOpenAnalyticsSelectedYearPicker"
                        class="analyticsYearPickerTrigger"/>
                </HBox>
                <Button text="{i18n>analyticsPresetCurrent}" type="Transparent" press=".onApplyAnalyticsYearPreset" class="analyticsPresetButton analyticsPresetCurrent">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/>
                    </layoutData>
                    <customData><core:CustomData key="preset" value="CURRENT"/></customData>
                </Button>
                <Button text="{i18n>analyticsPresetPrevious}" type="Transparent" press=".onApplyAnalyticsYearPreset" class="analyticsPresetButton analyticsPresetPrevious">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" moveToOverflow="true"/>
                    </layoutData>
                    <customData><core:CustomData key="preset" value="PREVIOUS"/></customData>
                </Button>
                <Label text="{i18n>analyticsCompareYearLabel}" labelFor="analyticsCompareYearInput" class="analyticsFilterLabel analyticsCompareYearLabel">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="Low" moveToOverflow="true" shrinkable="false"/>
                    </layoutData>
                </Label>
                <HBox class="analyticsYearField" renderType="Bare" alignItems="Center">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="High" moveToOverflow="true" shrinkable="true" minWidth="9rem"/>
                    </layoutData>
                    <Input
                        id="analyticsCompareYearInput"
                        width="7rem"
                        type="Text"
                        value="{view>/compareYear}"
                        valueState="{view>/compareYearValueState}"
                        valueStateText="{view>/compareYearValueStateText}"
                        maxLength="4"
                        liveChange=".onLiveChangeAnalyticsCompareYear"
                        change=".onChangeAnalyticsCompareYear"/>
                    <Button
                        icon="sap-icon://calendar"
                        type="Transparent"
                        tooltip="{i18n>analyticsCompareYearLabel}"
                        press=".onOpenAnalyticsCompareYearPicker"
                        class="analyticsYearPickerTrigger analyticsCompareYearPickerTrigger"/>
                </HBox>
            </OverflowToolbar>
        </subHeader>

        <content>
            <VBox class="appContent analyticsScreenContent workflowBusyScope" renderType="Bare">
                <VBox class="workflowBusyOverlayShell" renderType="Bare" visible="{view>/busy}">
                    <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowBusyOverlay" type="XML"/>
                </VBox>
                <VBox class="glassCard analyticsHeroCard" renderType="Bare">
                    <Text text="{i18n>analyticsScreenEyebrow}" class="workflowEyebrow"/>
                    <Title text="{i18n>workflowAnalyticsTitle}" level="H2" class="analyticsScreenTitle"/>
                    <Text text="{i18n>analyticsScreenSubtitle}" class="analyticsScreenSubtitle"/>
                    <HBox class="analyticsHeroContextRail" wrap="Wrap" renderType="Bare">
                        <ObjectStatus
                            text="{= ${i18n>analyticsSourceFilterLabel} + ': ' + (${view>/selectedSource} === 'WEB' ? ${i18n>analyticsSourceWeb} : (${view>/selectedSource} === 'INTEGRATION' ? ${i18n>analyticsSourceIntegration} : ${i18n>analyticsSourceAll})) }"
                            state="Information"
                            class="analyticsHeroContextChip statusChipSemantic"/>
                        <ObjectStatus
                            text="{= ${i18n>analyticsSelectedYear} + ': ' + ${view>/selectedYear} }"
                            state="Success"
                            class="analyticsHeroContextChip statusChipSemantic"/>
                        <ObjectStatus
                            text="{= ${i18n>analyticsCompareYearLabel} + ': ' + ${view>/compareYear} }"
                            state="None"
                            class="analyticsHeroContextChip statusChipSemantic"/>
                    </HBox>
                </VBox>

                <VBox class="analyticsScreenBody" renderType="Bare">
                    <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowAnalyticsMessageStack" type="XML"/>
                    <VBox class="sapUiSmallMarginTop analyticsToplineSection" renderType="Bare">
                        <HBox class="analyticsToplineGrid" wrap="Wrap" renderType="Bare">
                            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowAnalyticsToplinePrimaryCards" type="XML"/>
                            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowAnalyticsToplineRateCards" type="XML"/>
                        </HBox>

                        <HBox class="analyticsToplineMetaGrid sapUiSmallMarginTop" wrap="Wrap" renderType="Bare">
                            <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowStatusMetaChips" type="XML"/>
                        </HBox>
                    </VBox>
                    <core:Fragment fragmentName="PRODUCTION_CONTROL_CHECKLIST.views.fragment.WorkflowAnalyticsBreakdowns" type="XML"/>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
