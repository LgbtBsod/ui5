{
  "roots": [
    "scripts"
  ],
  "extensions": [
    ".js"
  ],
  "excludeFiles": [
    "scripts/unit-smoke.js"
  ],
  "blockLines": 6,
  "minBlockChars": 160,
  "maxCrossRootClusters": 5,
  "forbidSameRootClusters": false,
  "semanticMode": true,
  "minNormalizedChars": 40,
  "sampleLimit": 5
}
