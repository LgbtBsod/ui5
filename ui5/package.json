{
  "name": "production_control_checklist",
  "private": true,
  "scripts": {
    "build": "npm run build:dist",
    "build:dist": "ui5 build --clean-dest --dest dist",
    "build:preload": "ui5 build --clean-dest --dest dist",
    "lint:css": "stylelint \"app/styles/**/*.css\"",
    "validate": "npm run lint:css && npm run build:dist"
  },
  "devDependencies": {
    "@ui5/cli": "^3.11.5",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
