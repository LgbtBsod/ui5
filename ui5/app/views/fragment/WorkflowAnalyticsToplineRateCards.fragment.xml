<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox class="kpiCard analyticsToplineCard kpiRate" renderType="Bare">
        <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
            <core:Icon src="sap-icon://complete" class="kpiLabelIcon" decorative="true"/>
            <Text text="{i18n>analyticsAvgChecksRate}" class="kpiLabel"/>
        </HBox>
        <Title text="{= ${view>/analytics/avgChecksRate} + '%' }" level="H3" class="kpiValue analyticsValue"/>
        <Text text="{i18n>analyticsChecksSuccessRate}" class="analyticsToplineSubhead"/>
    </VBox>

    <VBox class="kpiCard analyticsToplineCard kpiPassed" renderType="Bare">
        <HBox class="kpiLabelRow" renderType="Bare" alignItems="Center">
            <core:Icon src="sap-icon://sys-enter-2" class="kpiLabelIcon" decorative="true"/>
            <Text text="{i18n>analyticsAvgBarriersRate}" class="kpiLabel"/>
        </HBox>
        <Title text="{= ${view>/analytics/avgBarriersRate} + '%' }" level="H3" class="kpiValue analyticsValue"/>
        <Text text="{i18n>analyticsBarriersSuccessRate}" class="analyticsToplineSubhead"/>
    </VBox>
</core:FragmentDefinition>
