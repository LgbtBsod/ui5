<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <OverflowToolbar class="detailControlRow detailControlRowTop toolbarTransparent" design="Transparent">
        <customData>
            <core:CustomData key="role" value="status" writeToDom="true"/>
            <core:CustomData key="aria-live" value="polite" writeToDom="true"/>
            <core:CustomData key="aria-label" value="{i18n>detailStatusRailAriaLabel}" writeToDom="true"/>
        </customData>

        <ObjectStatus
            icon="sap-icon://status-in-process"
            text="{path:'selected>/root/status', formatter:'.formatLifecycleStatusText'}"
            state="{path:'selected>/root/status', formatter:'.formatLifecycleStatusState'}"
            class="detailRailStatusChip statusChipSemantic"
            tooltip="{i18n>objectStatusLabel}"/>

        <ObjectStatus
            icon="sap-icon://edit"
            text="{= ${state>/isDirty} ? ${i18n>dirtyStateDirty} : ${i18n>dirtyStateSynced} }"
            state="{= ${state>/isDirty} ? 'Warning' : 'Success' }"
            class="detailRailStatusChip statusChipSemantic">
            <layoutData>
                <OverflowToolbarLayoutData priority="High"/>
            </layoutData>
        </ObjectStatus>

        <ObjectStatus
            icon="sap-icon://history"
            text="{parts:[{path:'state>/workflow/detail/editMode'},{path:'state>/workflow/detail/lock/state'}], formatter:'.formatHeartbeatText'}"
            state="{parts:[{path:'state>/workflow/detail/lock/state'},{path:'state>/workflow/detail/editMode'}], formatter:'.formatLockStateSemantic'}"
            tooltip="{i18n>heartbeatLabel}"
            class="detailRailStatusChip statusChipSemantic">
            <layoutData>
                <OverflowToolbarLayoutData priority="Disappear"/>
            </layoutData>
        </ObjectStatus>

        <ObjectStatus
            icon="sap-icon://synchronize"
            text="{parts:[{path:'state>/persistence/messageKey'},{path:'state>/persistence/state'},{path:'state>/persistence/lastSavedAt'}], formatter:'.formatPersistenceText'}"
            state="{path:'state>/persistence/state', formatter:'.formatPersistenceState'}"
            tooltip="{parts:[{path:'state>/persistence/messageKey'},{path:'state>/persistence/state'},{path:'state>/persistence/lastSavedAt'},{path:'state>/persistence/lastSaveError'}], formatter:'.formatPersistenceTooltip'}"
            class="detailRailStatusChip statusChipSemantic">
            <layoutData>
                <OverflowToolbarLayoutData priority="Disappear"/>
            </layoutData>
        </ObjectStatus>

        <ToolbarSpacer/>

        <BusyIndicator visible="{= ${state>/ui/busy/detail} || ${state>/saveInFlight} }" size="1rem" class="sapUiTinyMarginEnd">
            <layoutData>
                <OverflowToolbarLayoutData priority="Disappear"/>
            </layoutData>
        </BusyIndicator>

        <Button
            icon="sap-icon://undo"
            text="{i18n>objectCancel}"
            visible="{= ${state>/workflow/detail/editMode} !== 'READ' &amp;&amp; !!${state>/isDirty} }"
            enabled="{= !${state>/ui/busy/detail} &amp;&amp; !${state>/lockOperationPending} }"
            press=".onCancelEditFromDetail"
            tooltip="{i18n>objectCancelTooltip}"
            class="actionPrioritySecondary chkRipple">
            <layoutData>
                <OverflowToolbarLayoutData priority="High"/>
            </layoutData>
        </Button>
    </OverflowToolbar>
</core:FragmentDefinition>
