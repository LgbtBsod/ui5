{
  "name": "production-control-checklist",
  "version": "1.0.0",
  "private": true,
  "description": "Production Control Checklists UI5 application",
  "scripts": {
    "start": "ui5 serve --config ui5.yaml --open index.html",
    "build": "npm run build:dist",
    "build:dist": "ui5 build --config ui5.yaml --clean-dest --dest dist",
    "build:preload": "ui5 build preload --config ui5.yaml --clean-dest --dest dist",
    "test:unit": "ui5 serve --config ui5.yaml --open test/unit/unitTests.qunit.html",
    "test:opa": "ui5 serve --config ui5.yaml --open test/integration/opaTests.qunit.html",
    "lint:css": "node node_modules/stylelint/bin/stylelint.mjs \"app/styles/**/*.css\"",
    "validate": "npm run check:eol && npm run lint:css && node scripts/css-duplicate-selector-gate.js && npm run build:preload",
    "check:eol": "node scripts/check-eol.js",
    "gate:persistence-i18n": "node scripts/persistence-i18n-gate.js",
    "gate:release": "node scripts/release-readiness-gate.js",
    "smoke:local": "powershell -ExecutionPolicy Bypass -File scripts/local-launch-smoke.ps1"
  },
  "devDependencies": {
    "@ui5/cli": "^3.11.6",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
