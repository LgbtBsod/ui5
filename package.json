{
  "name": "production-control-checklist",
  "version": "1.0.0",
  "private": true,
  "description": "Production Control Checklists UI5 application",
  "scripts": {
    "start": "node scripts/start-local-server.js",
    "build": "npm run build:dist",
    "build:dist": "node scripts/build-dist-local.js",
    "build:preload": "node scripts/build-preload-local.js",
    "build:preload:sap": "ui5 build preload --config ui5.yaml --clean-dest --dest dist",
    "test:unit": "node scripts/unit-smoke.js",
    "test:opa": "python scripts/interaction-smoke.py",
    "test:governance": "node scripts/governance-smoke.js",
    "serve:test": "node scripts/start-local-server.js",
    "lint:css": "stylelint \"app/styles/**/*.css\"",
    "smoke:gateway:lifecycle": "python scripts/gateway-detail-lifecycle-proof.py",
    "smoke:ui5-cache": "python scripts/ui5-resource-cache-regression.py",
    "validate": "npm run check:eol && npm run lint:css && node scripts/css-duplicate-selector-gate.js && npm run build:preload",
    "check:eol": "node scripts/check-eol.js",
    "gate:persistence-i18n": "node scripts/persistence-i18n-gate.js",
    "gate:release": "node scripts/release-readiness-gate.js",
    "smoke:local": "powershell -ExecutionPolicy Bypass -File scripts/local-launch-smoke.ps1"
  },
  "devDependencies": {
    "@ui5/cli": "^3.11.6",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
