{
  "name": "production-control-checklist",
  "version": "1.0.0",
  "private": true,
  "description": "Production Control Checklists UI5 application",
  "scripts": {
    "start": "ui5 serve --config ui5.yaml --open index.html",
    "build": "ui5 build --config ui5.yaml --clean-dest --dest dist",
    "test:unit": "ui5 serve --config ui5.yaml --open test/unit/unitTests.qunit.html",
    "test:opa": "ui5 serve --config ui5.yaml --open test/integration/opaTests.qunit.html",
    "gate:release": "node scripts/release-readiness-gate.js",
    "smoke:local": "powershell -ExecutionPolicy Bypass -File scripts/local-launch-smoke.ps1"
  },
  "devDependencies": {
    "@ui5/cli": "^3.11.6"
  }
}
